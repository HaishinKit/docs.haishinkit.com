{"variants":[{"paths":["\/documentation\/vpxhaishinkit"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"url":"doc:\/\/VPXHaishinKit\/documentation\/VPXHaishinKit","interfaceLanguage":"swift"},"sections":[],"hierarchy":{"paths":[[]]},"kind":"symbol","metadata":{"role":"collection","roleHeading":"Framework","modules":[{"name":"VPXHaishinKit"}],"externalID":"VPXHaishinKit","title":"VPXHaishinKit","symbolKind":"module","images":[{"type":"icon","identifier":"vpxhaishinkit-icon.png"},{"type":"card","identifier":"vpxhaishinkit-card.png"}]},"abstract":[{"type":"text","text":"Standalone software VP8 and VP9 encoding and decoding."}],"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"This optional product exposes "},{"type":"reference","identifier":"doc:\/\/VPXHaishinKit\/documentation\/VPXHaishinKit\/VPXVideoEncoder","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/VPXHaishinKit\/documentation\/VPXHaishinKit\/VPXVideoDecoder","isActive":true},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/VPXHaishinKit\/documentation\/VPXHaishinKit\/VPXVideoCodecSettings","isActive":true},{"type":"text","text":" without depending on the "},{"code":"HaishinKit","type":"codeVoice"},{"type":"text","text":" target. Applications"},{"type":"text","text":" "},{"type":"text","text":"such as VQMetrix can call it directly. The existing "},{"code":"VideoCodec","type":"codeVoice"},{"type":"text","text":", codec registration,"},{"type":"text","text":" "},{"type":"text","text":"MediaMixer, and RTC\/RTMP\/SRT pipelines are unchanged; importing this product does not"},{"type":"text","text":" "},{"type":"text","text":"add VP8\/VP9 transport support."}]},{"type":"heading","text":"Installation","anchor":"Installation","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"This product is available on main, but is not included in the released 2.3.0 package:"}]},{"syntax":"swift","type":"codeListing","code":[".package(url: \"https:\/\/github.com\/HaishinKit\/HaishinKit.swift.git\",","         branch: \"main\")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add "},{"code":".product(name: \"VPXHaishinKit\", package: \"HaishinKit.swift\")","type":"codeVoice"},{"type":"text","text":" to your target."},{"type":"text","text":" "},{"type":"text","text":"After publication, replace the main branch with a release containing this product."}]},{"type":"heading","text":"Standalone conversion","anchor":"Standalone-conversion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following function needs no "},{"code":"import HaishinKit","type":"codeVoice"},{"type":"text","text":" or shared codec registration:"}]},{"syntax":"swift","type":"codeListing","code":["import CoreMedia","import VPXHaishinKit","","func roundTrip(_ references: [CMSampleBuffer]) throws -> [CMSampleBuffer] {","    let settings = VPXVideoCodecSettings(bitRate: 1_000_000, format: .vp9)","    let encoder = try VPXVideoEncoder(settings: settings)","    let decoder = try VPXVideoDecoder(format: .vp9)","    defer { encoder.invalidate(); decoder.invalidate() }","    var restored: [CMSampleBuffer] = []","    for reference in references {","        for packet in try encoder.encode(reference) {","            restored += try decoder.decode(packet)","        }","    }","    for packet in try encoder.finish() {","        restored += try decoder.decode(packet)","    }","    return restored","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"encode"},{"type":"text","text":" and "},{"type":"codeVoice","code":"decode"},{"type":"text","text":" synchronously return owned Core Media samples. Copying encoded"},{"type":"text","text":" "},{"type":"text","text":"bytes and decoded pixels before libvpx reuses its buffers makes retained outputs safe."},{"type":"text","text":" "},{"type":"text","text":"The classes are deliberately non-Sendable: create and use each instance on one actor"},{"type":"text","text":" "},{"type":"text","text":"or serial executor. Software compression runs on that caller; use a worker executor"},{"text":" ","type":"text"},{"text":"for UI applications. The APIs throw errors directly rather than dropping outputs","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"through an asynchronous continuation."}]},{"type":"heading","text":"Settings and lifecycle","anchor":"Settings-and-lifecycle","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"VP8 and VP9 use 8-bit SDR 4:2:0. The encoder accepts only video-range planar"},{"type":"text","text":" "},{"type":"text","text":"I420 ("},{"type":"codeVoice","code":"kCVPixelFormatType_420YpCbCr8Planar"},{"type":"text","text":"), with dimensions exactly matching"},{"type":"text","text":" "},{"type":"codeVoice","code":"videoSize"},{"type":"text","text":". It passes the three planes and their row strides directly to libvpx"},{"type":"text","text":" "},{"type":"text","text":"while the input pixel buffer is locked. The caller is responsible for color-space"},{"type":"text","text":" "},{"type":"text","text":"conversion, range normalization, and resizing before encoding. NV12, RGB, full-range,"},{"type":"text","text":" "},{"type":"text","text":"10-bit, and mismatched dimensions are rejected rather than converted implicitly."},{"type":"text","text":" "},{"type":"text","text":"Encoded width\/height must be positive even integers, within the codec limit, and"},{"type":"text","text":" "},{"type":"text","text":"their product must not exceed 16,777,216 pixels. VP9 high-bit-depth and 4:4:4 are not supported."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"PTS values must be numeric, epoch zero, and strictly increasing after conversion"},{"type":"text","text":" "},{"type":"text","text":"to a microsecond timebase. Numeric positive input durations are preserved to that"},{"type":"text","text":" "},{"type":"text","text":"precision; otherwise the frame-rate hint provides a duration. The hint must be finite"},{"type":"text","text":" "},{"type":"text","text":"and between 0.001 and 1,000,000 fps. Keyframe intervals are timestamp-based, between"},{"type":"text","text":" "},{"type":"text","text":"one microsecond and one hour, so skipped inputs do not extend the keyframe interval."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Compression uses realtime, zero-lookahead operation with no intentional frame drops"},{"type":"text","text":" "},{"type":"text","text":"or frame reordering. Average and constant bitrate modes are available. Call "},{"code":"update","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"to change bitrate and frame-rate hints. Changing codec, dimensions,"},{"type":"text","text":" "},{"type":"text","text":"bitrate mode, or keyframe interval requires a new encoder and is rejected by "},{"code":"update","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"codeVoice","code":"finish"},{"type":"text","text":" drains the encoder and rejects further input; repeated calls return no"},{"type":"text","text":" "},{"text":"packets. ","type":"text"},{"type":"codeVoice","code":"invalidate"},{"text":" releases resources and is safe to call repeatedly. Construct","type":"text"},{"type":"text","text":" "},{"type":"text","text":"new encoder\/decoder instances to restart."}]},{"type":"paragraph","inlineContent":[{"text":"The decoder consumes raw compressed VP8\/VP9 samples with a matching format description,","type":"text"},{"text":" ","type":"text"},{"text":"and returns NV12 frames with the packet PTS\/duration and decoded full\/video range.","type":"text"},{"text":" ","type":"text"},{"text":"The caller must demultiplex a container and supply packet timing; this module does not","type":"text"},{"text":" ","type":"text"},{"text":"read\/write MP4, IVF, or WebM files, nor add RTP\/Enhanced RTMP\/TS framing.","type":"text"},{"text":" ","type":"text"},{"text":"Only decoded pixel range is signaled here; interpreting and attaching container colorimetry remains the caller’s responsibility.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Encoding and decoding follow the package’s existing platform minimums; this module","type":"text"},{"text":" ","type":"text"},{"text":"does not depend on VideoToolbox pixel transfer. The libvpx 1.17.0 artifact supports arm64, including Apple silicon","type":"text"},{"text":" ","type":"text"},{"text":"simulators; it does not include Intel slices. Preserve the libvpx LICENSE and PATENTS","type":"text"},{"text":" ","type":"text"},{"text":"notices from libvpx-xcframework when distributing an app.","type":"text"}]},{"type":"heading","text":"Encoder statistics","anchor":"Encoder-statistics","level":2},{"type":"paragraph","inlineContent":[{"text":"Read ","type":"text"},{"identifier":"doc:\/\/VPXHaishinKit\/documentation\/VPXHaishinKit\/VPXVideoEncoder\/statistics","isActive":true,"type":"reference"},{"text":" on the encoder’s actor or serial executor,","type":"text"},{"text":" ","type":"text"},{"text":"then send the value snapshot to VQMetrix’s UI, history store, or report:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let snapshot = encoder.statistics","print(snapshot.submittedFrameCount, snapshot.outputPacketCount, snapshot.encodedByteCount)","print(snapshot.lastEncodingDuration, snapshot.averageEncodingDuration,","      snapshot.maximumEncodingDuration, snapshot.totalEncodingDuration)"]},{"type":"paragraph","inlineContent":[{"text":"Durations are monotonic wall-clock seconds inside successful native frame-encode calls,","type":"text"},{"text":" ","type":"text"},{"text":"including scheduling delays. They exclude caller conversion, input validation, output","type":"text"},{"text":" ","type":"text"},{"text":"copying, failed encode calls, and ","type":"text"},{"code":"finish()","type":"codeVoice"},{"type":"text","text":" flushing. They are not CPU utilization,"},{"type":"text","text":" "},{"type":"text","text":"thermal state, energy use, or end-to-end latency. Packet\/byte counters include drained"},{"type":"text","text":" "},{"type":"text","text":"output. Counters live for the encoder’s lifetime, survive invalidation, and are not"},{"type":"text","text":" "},{"type":"text","text":"reset by settings updates. Snapshots are Codable and Sendable."}]},{"type":"heading","text":"Verification","anchor":"Verification","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Run "},{"code":"swift test --filter VPXVideoCodecTests","type":"codeVoice"},{"type":"text","text":" for both codec round trips, owned outputs,"},{"type":"text","text":" "},{"type":"text","text":"keyframe timing, settings updates, unsupported input\/dimension rejection, malformed packets, and lifecycle checks."},{"type":"text","text":" "},{"code":"swift run --package-path VPXHaishinKit\/Tests\/Consumer Consumer","type":"codeVoice"},{"type":"text","text":" exercises a separate"},{"type":"text","text":" "},{"type":"text","text":"SwiftPM consumer importing only the public VPX API, without linking the HaishinKit core."}]},{"type":"paragraph","inlineContent":[{"text":"The published libvpx 1.17.0 artifact includes embedded DWARF debug information in its static libraries. Retain the final app archive and matching app dSYM for symbolication.","type":"text"}]}],"kind":"content"}],"topicSections":[{"identifiers":["doc:\/\/VPXHaishinKit\/documentation\/VPXHaishinKit\/VPXVideoEncoder","doc:\/\/VPXHaishinKit\/documentation\/VPXHaishinKit\/VPXVideoDecoder"],"title":"Encoding and decoding","anchor":"Encoding-and-decoding"},{"identifiers":["doc:\/\/VPXHaishinKit\/documentation\/VPXHaishinKit\/VPXVideoCodecSettings","doc:\/\/VPXHaishinKit\/documentation\/VPXHaishinKit\/VPXVideoCodecSettings\/Format-swift.enum","doc:\/\/VPXHaishinKit\/documentation\/VPXHaishinKit\/VPXVideoCodecSettings\/BitRateMode-swift.enum","doc:\/\/VPXHaishinKit\/documentation\/VPXHaishinKit\/VPXVideoCodecError"],"title":"Configuration and failures","anchor":"Configuration-and-failures"},{"identifiers":["doc:\/\/VPXHaishinKit\/documentation\/VPXHaishinKit\/VPXVideoEncoderStatistics"],"title":"Measurement","anchor":"Measurement"}],"references":{"vpxhaishinkit-icon.png":{"variants":[{"traits":["1x","light"],"url":"\/images\/VPXHaishinKit\/vpxhaishinkit-icon.png"}],"type":"image","identifier":"vpxhaishinkit-icon.png","alt":"Stacked video frames for VP8 and VP9"},"doc://VPXHaishinKit/documentation/VPXHaishinKit/VPXVideoCodecSettings":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"VPXVideoCodecSettings"}],"navigatorTitle":[{"kind":"identifier","text":"VPXVideoCodecSettings"}],"identifier":"doc:\/\/VPXHaishinKit\/documentation\/VPXHaishinKit\/VPXVideoCodecSettings","abstract":[{"text":"Settings for standalone, 8-bit software VP8\/VP9 compression.","type":"text"}],"type":"topic","url":"\/documentation\/vpxhaishinkit\/vpxvideocodecsettings","kind":"symbol","title":"VPXVideoCodecSettings","role":"symbol"},"doc://VPXHaishinKit/documentation/VPXHaishinKit/VPXVideoEncoder/statistics":{"role":"symbol","url":"\/documentation\/vpxhaishinkit\/vpxvideoencoder\/statistics","type":"topic","identifier":"doc:\/\/VPXHaishinKit\/documentation\/VPXHaishinKit\/VPXVideoEncoder\/statistics","title":"statistics","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"statistics"},{"kind":"text","text":": "},{"preciseIdentifier":"s:13VPXHaishinKit25VPXVideoEncoderStatisticsV","kind":"typeIdentifier","text":"VPXVideoEncoderStatistics"}],"abstract":[{"type":"text","text":"Current lifetime statistics. Read on the same actor or serial executor as encode calls."},{"type":"text","text":" "},{"type":"text","text":"Copy this Sendable value to forward a snapshot to a UI, history store, or report."}],"kind":"symbol"},"doc://VPXHaishinKit/documentation/VPXHaishinKit/VPXVideoEncoder":{"role":"symbol","url":"\/documentation\/vpxhaishinkit\/vpxvideoencoder","type":"topic","identifier":"doc:\/\/VPXHaishinKit\/documentation\/VPXHaishinKit\/VPXVideoEncoder","navigatorTitle":[{"kind":"identifier","text":"VPXVideoEncoder"}],"title":"VPXVideoEncoder","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"VPXVideoEncoder"}],"abstract":[{"type":"text","text":"A synchronous encoder. Confine the instance and its calls to one actor or serial executor."}],"kind":"symbol"},"vpxhaishinkit-card.png":{"variants":[{"traits":["1x","light"],"url":"\/images\/VPXHaishinKit\/vpxhaishinkit-card.png"}],"type":"image","identifier":"vpxhaishinkit-card.png","alt":"Stacked video frames for VP8 and VP9"},"doc://VPXHaishinKit/documentation/VPXHaishinKit/VPXVideoCodecError":{"type":"topic","navigatorTitle":[{"kind":"identifier","text":"VPXVideoCodecError"}],"identifier":"doc:\/\/VPXHaishinKit\/documentation\/VPXHaishinKit\/VPXVideoCodecError","role":"symbol","kind":"symbol","title":"VPXVideoCodecError","abstract":[{"text":"A standalone codec failure. Unsupported configurations never select another codec.","type":"text"}],"url":"\/documentation\/vpxhaishinkit\/vpxvideocodecerror","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"VPXVideoCodecError"}]},"doc://VPXHaishinKit/documentation/VPXHaishinKit/VPXVideoCodecSettings/BitRateMode-swift.enum":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BitRateMode","kind":"identifier"}],"navigatorTitle":[{"text":"BitRateMode","kind":"identifier"}],"identifier":"doc:\/\/VPXHaishinKit\/documentation\/VPXHaishinKit\/VPXVideoCodecSettings\/BitRateMode-swift.enum","abstract":[{"type":"text","text":"The libvpx rate-control strategy. Neither mode guarantees an exact bitrate."}],"type":"topic","url":"\/documentation\/vpxhaishinkit\/vpxvideocodecsettings\/bitratemode-swift.enum","kind":"symbol","title":"VPXVideoCodecSettings.BitRateMode","role":"symbol"},"doc://VPXHaishinKit/documentation/VPXHaishinKit/VPXVideoCodecSettings/Format-swift.enum":{"role":"symbol","url":"\/documentation\/vpxhaishinkit\/vpxvideocodecsettings\/format-swift.enum","type":"topic","identifier":"doc:\/\/VPXHaishinKit\/documentation\/VPXHaishinKit\/VPXVideoCodecSettings\/Format-swift.enum","navigatorTitle":[{"text":"Format","kind":"identifier"}],"title":"VPXVideoCodecSettings.Format","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Format","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"The compressed bitstream format.","type":"text"}]},"doc://VPXHaishinKit/documentation/VPXHaishinKit":{"images":[{"type":"icon","identifier":"vpxhaishinkit-icon.png"},{"type":"card","identifier":"vpxhaishinkit-card.png"}],"identifier":"doc:\/\/VPXHaishinKit\/documentation\/VPXHaishinKit","abstract":[{"type":"text","text":"Standalone software VP8 and VP9 encoding and decoding."}],"type":"topic","url":"\/documentation\/vpxhaishinkit","kind":"symbol","title":"VPXHaishinKit","role":"collection"},"doc://VPXHaishinKit/documentation/VPXHaishinKit/VPXVideoDecoder":{"type":"topic","navigatorTitle":[{"kind":"identifier","text":"VPXVideoDecoder"}],"identifier":"doc:\/\/VPXHaishinKit\/documentation\/VPXHaishinKit\/VPXVideoDecoder","role":"symbol","kind":"symbol","title":"VPXVideoDecoder","abstract":[{"text":"A synchronous decoder. Returned frames own their pixel storage; calls must be serialized.","type":"text"}],"url":"\/documentation\/vpxhaishinkit\/vpxvideodecoder","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"VPXVideoDecoder"}]},"doc://VPXHaishinKit/documentation/VPXHaishinKit/VPXVideoEncoderStatistics":{"role":"symbol","url":"\/documentation\/vpxhaishinkit\/vpxvideoencoderstatistics","type":"topic","identifier":"doc:\/\/VPXHaishinKit\/documentation\/VPXHaishinKit\/VPXVideoEncoderStatistics","navigatorTitle":[{"text":"VPXVideoEncoderStatistics","kind":"identifier"}],"title":"VPXVideoEncoderStatistics","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"VPXVideoEncoderStatistics","kind":"identifier"}],"kind":"symbol","abstract":[{"type":"text","text":"A value snapshot of one encoder’s lifetime counters, suitable for reports and cross-actor transfer."}]}}}