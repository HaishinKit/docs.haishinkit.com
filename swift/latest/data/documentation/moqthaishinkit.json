{"sections":[],"kind":"symbol","primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"text":"MoQTHaishinKit implements the native QUIC client subset of","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"https:\/\/datatracker.ietf.org\/doc\/html\/draft-ietf-moq-transport-23","type":"reference"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Connection APIs require iOS 16, macOS 13, or tvOS 16.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Connect to a ","type":"text"},{"type":"codeVoice","code":"moqt:\/\/"},{"type":"text","text":" endpoint and consume "},{"type":"codeVoice","code":"objectStream"},{"type":"text","text":" for incoming"},{"type":"text","text":" "},{"type":"text","text":"subgroup objects and datagrams."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let connection = MoQTConnection(.subscriber)","let objects = await connection.objectStream","_ = try await connection.connect(\"moqt:\/\/relay.example\/live\")","","do {","    let subscription = try await connection.subscribe([\"live\"], name: \"video\")","    print(subscription.trackAlias)","} catch let rejection as MoQTRequestError {","    print(rejection.code, rejection.reasonPhrase)","}","","for await object in objects {","    \/\/ Use object.trackAlias to identify the subscription.","    print(object.id)","}"]},{"inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"publishNamespace"},{"type":"text","text":" to advertise a namespace and "},{"type":"codeVoice","code":"subscribeNamespace"},{"type":"text","text":" to"},{"type":"text","text":" "},{"type":"text","text":"receive namespace discovery updates. Both throw "},{"type":"codeVoice","code":"MoQTRequestError"},{"type":"text","text":" when the"},{"type":"text","text":" "},{"type":"text","text":"peer rejects the request. For authenticated requests, supply a"},{"type":"text","text":" "},{"type":"codeVoice","code":"MoQTAuthorizationToken"},{"type":"text","text":" with the token type and bytes expected by the peer."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"fetch(_:name:range:authorizationToken:)"},{"type":"text","text":" to retrieve stored objects in"},{"type":"text","text":" "},{"type":"text","text":"ascending group order. Each fetch returns its own asynchronous object stream."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"subscribeTracks(_:authorizationToken:)"},{"type":"text","text":" to subscribe by namespace prefix."},{"type":"text","text":" "},{"type":"text","text":"The client accepts matching PUBLISH requests associated with the prefix"},{"type":"text","text":" "},{"type":"text","text":"subscription and reports them through the returned event stream. Live objects"},{"type":"text","text":" "},{"type":"text","text":"arrive on "},{"type":"codeVoice","code":"objectStream"},{"type":"text","text":" and carry the assigned track alias."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"setPaused(_:trackAlias:)"},{"type":"text","text":" to change an active subscription’s pause state"},{"type":"text","text":" "},{"type":"text","text":"with REQUEST_UPDATE. The local state changes after the peer acknowledges it."},{"type":"text","text":" "},{"type":"text","text":"For outgoing publications, use "},{"type":"codeVoice","code":"publish(_:name:trackAlias:authorizationToken:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"send subgroup objects using that alias, and call "},{"type":"codeVoice","code":"finishPublishing(trackAlias:)"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Incoming REQUEST_UPDATE messages can pause or resume those publications."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This client supports pause and resume updates. Other update parameters,"},{"type":"text","text":" "},{"type":"text","text":"unsolicited incoming publications, serving incoming FETCH and SUBSCRIBE_TRACKS"},{"type":"text","text":" "},{"type":"text","text":"requests, WebTransport, automatic session migration, and relay behavior are"},{"type":"text","text":" "},{"type":"text","text":"outside the implemented subset."}],"type":"paragraph"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/MoQTHaishinKit\/documentation\/MoQTHaishinKit"},"metadata":{"title":"MoQTHaishinKit","role":"collection","modules":[{"name":"MoQTHaishinKit"}],"images":[{"identifier":"moqthaishinkit-icon.svg","type":"icon"},{"identifier":"moqthaishinkit-card.svg","type":"card"}],"externalID":"MoQTHaishinKit","symbolKind":"module","roleHeading":"Framework"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/moqthaishinkit"]}],"topicSections":[{"identifiers":["doc:\/\/MoQTHaishinKit\/documentation\/MoQTHaishinKit\/MoQTConnection"],"generated":true,"anchor":"Classes","title":"Classes"},{"identifiers":["doc:\/\/MoQTHaishinKit\/documentation\/MoQTHaishinKit\/MoQTAuthorizationToken","doc:\/\/MoQTHaishinKit\/documentation\/MoQTHaishinKit\/MoQTFetchRange","doc:\/\/MoQTHaishinKit\/documentation\/MoQTHaishinKit\/MoQTGoAway","doc:\/\/MoQTHaishinKit\/documentation\/MoQTHaishinKit\/MoQTKeyValue","doc:\/\/MoQTHaishinKit\/documentation\/MoQTHaishinKit\/MoQTObject","doc:\/\/MoQTHaishinKit\/documentation\/MoQTHaishinKit\/MoQTPublishedTrack","doc:\/\/MoQTHaishinKit\/documentation\/MoQTHaishinKit\/MoQTRequestError","doc:\/\/MoQTHaishinKit\/documentation\/MoQTHaishinKit\/MoQTRequestOk","doc:\/\/MoQTHaishinKit\/documentation\/MoQTHaishinKit\/MoQTRequestState","doc:\/\/MoQTHaishinKit\/documentation\/MoQTHaishinKit\/MoQTSetup","doc:\/\/MoQTHaishinKit\/documentation\/MoQTHaishinKit\/MoQTStreamHeaderSubgroup","doc:\/\/MoQTHaishinKit\/documentation\/MoQTHaishinKit\/MoQTSubscribeOk"],"generated":true,"anchor"