{"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"externalID":"MoQTHaishinKit","role":"collection","modules":[{"name":"MoQTHaishinKit"}],"roleHeading":"Framework","title":"MoQTHaishinKit","symbolKind":"module","images":[{"identifier":"moqthaishinkit-icon.svg","type":"icon"},{"identifier":"moqthaishinkit-card.svg","type":"card"}]},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"MoQTHaishinKit implements the native QUIC client subset of","type":"text"},{"text":" ","type":"text"},{"identifier":"https:\/\/datatracker.ietf.org\/doc\/html\/draft-ietf-moq-transport-23","type":"reference","isActive":true},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Connection APIs require iOS 16, macOS 13, or tvOS 16.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Connect to a ","type":"text"},{"code":"moqt:\/\/","type":"codeVoice"},{"text":" endpoint and consume ","type":"text"},{"code":"objectStream","type":"codeVoice"},{"text":" for incoming","type":"text"},{"text":" ","type":"text"},{"text":"subgroup objects and datagrams.","type":"text"}]},{"type":"codeListing","code":["let connection = MoQTConnection(.subscriber)","let objects = await connection.objectStream","_ = try await connection.connect(\"moqt:\/\/relay.example\/live\")","","do {","    let subscription = try await connection.subscribe([\"live\"], name: \"video\")","    print(subscription.trackAlias)","} catch let rejection as MoQTRequestError {","    print(rejection.code, rejection.reasonPhrase)","}","","for await object in objects {","    \/\/ Use object.trackAlias to identify the subscription.","    print(object.id)","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"code":"publishNamespace","type":"codeVoice"},{"text":" to advertise a namespace and ","type":"text"},{"code":"subscribeNamespace","type":"codeVoice"},{"text":" to","type":"text"},{"text":" ","type":"text"},{"text":"receive namespace discovery updates. Both throw ","type":"text"},{"code":"MoQTRequestError","type":"codeVoice"},{"text":" when the","type":"text"},{"text":" ","type":"text"},{"text":"peer rejects the request. For authenticated requests, supply a","type":"text"},{"text":" ","type":"text"},{"code":"MoQTAuthorizationToken","type":"codeVoice"},{"text":" with the token type and bytes expected by the peer.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"code":"fetch(_:name:range:authorizationToken:)","type":"codeVoice"},{"text":" to retrieve stored objects in","type":"text"},{"text":" ","type":"text"},{"text":"ascending group order. Each fetch returns its own asynchronous object stream.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"code":"subscribeTracks(_:authorizationToken:)","type":"codeVoice"},{"text":" to subscribe by namespace prefix.","type":"text"},{"text":" ","type":"text"},{"text":"The client accepts matching PUBLISH requests associated with the prefix","type":"text"},{"text":" ","type":"text"},{"text":"subscription and reports them through the returned event stream. Live objects","type":"text"},{"text":" ","type":"text"},{"text":"arrive on ","type":"text"},{"code":"objectStream","type":"codeVoice"},{"text":" and carry the assigned track alias.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"code":"setPaused(_:trackAlias:)","type":"codeVoice"},{"text":" to change an active subscription’s pause state","type":"text"},{"text":" ","type":"text"},{"text":"with REQUEST_UPDATE. The local state changes after the peer acknowledges it.","type":"text"},{"text":" ","type":"text"},{"text":"For outgoing publications, use ","type":"text"},{"code":"publish(_:name:trackAlias:authorizationToken:)","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"send subgroup objects using that alias, and call ","type":"text"},{"code":"finishPublishing(trackAlias:)","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Incoming REQUEST_UPDATE messages can pause or resume those publications.","type":"text"}]},{"inlineContent":[{"text":"This client supports pause and resume updates. Other update parameters,","type":"text"},{"text":" ","type":"text"},{"text":"unsolicited incoming publications, serving incoming FETCH and SUBSCRIBE_TRACKS","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"requests, WebTransport, automatic session migration, and relay behavior are"},{"type":"text","text":" "},{"type":"text","text":"outside the implemented subset."}],"type":"paragraph"}]}],"hierarchy":{"paths":[[]]},"kind":"symbol","abstract":[{"type":"text","text":"This module supports the MoQT protocol."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/moqthaishinkit"]}],"topicSections":[{"identifiers":["doc:\/\/MoQTHaishinKit\/documentation\/MoQTHaishinKit\/MoQTConnection"],"title":"Classes","anchor":"Classes","generated":true},{"identifiers":["doc:\/\/MoQTHaishinKit\/documentation\/MoQTHaishinKit\/MoQTAuthorizationToken","doc:\/\/MoQTHaishinKit\/documentation\/MoQTHaishinKit\/MoQTFetchRange","doc:\/\/MoQTHaishinKit\/documentation\/MoQTHaishinKit\/MoQTGoAway","doc:\/\/MoQTHaishinKit\/documentation\/MoQTHaishinKit\/MoQTKeyValue","doc:\/\/MoQTHaishinKit\/documentation\/MoQTHaishinKit\/MoQTObject","doc:\/\/MoQTHaishinKit\/documentation\/MoQTHaishinKit\/MoQTPublishedTrack","doc:\/\/MoQTHaishinKit\/documentation\/MoQTHaishinKit\/MoQTRequestError","doc:\/\/MoQTHaishinKit\/documentation\/MoQTHaishinKit\/MoQTRequestOk","doc:\/\/MoQTHaishinKit\/documentation\/MoQTHaishinKit\/MoQTRequestState","doc:\/\/MoQTHaishinKit\/documentation\/MoQTHaishinKit\/MoQTSetup","doc:\/\/MoQTHaishinKit\/documentation\/MoQTHaishinKit\/MoQTStreamHeaderSubgroup","doc:\/\/MoQTHaishinKit\/documentation\/MoQTHaishinKit\/MoQTSubsc