{"abstract":[{"text":"Update code written for HaishinKit 2.0.x to use the 2.1.0 APIs.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/haishinkit\/migration-2.0.x-to-2.1.0"]}],"primaryContentSections":[{"content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"This is a historical migration guide. Code examples refer to the versions shown in each section and may not match the current release.","type":"text"}]},{"anchor":"Package","text":"Package","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"In this version, we have restructured the module configuration. The RTMP-related features that were previously in HaishinKit have been moved to RTMPHaishinKit.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Several classes that were previously at the public level have been changed to package-level and are no longer exposed.","type":"text"}]},{"anchor":"Import","text":"Import","type":"heading","level":4},{"anchor":"20x","text":"2.0.x","type":"heading","level":5},{"syntax":"swift","code":["import HaishinKit","","let connection = RTMPConnection()"],"type":"codeListing"},{"anchor":"21x","text":"2.1.x","type":"heading","level":5},{"syntax":"swift","code":["import HaishinKit","import RTMPHaishinKit","","let connection = RTMPConnection()"],"type":"codeListing"},{"anchor":"Package-Manager","text":"Package Manager","type":"heading","level":4},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"https:\/\/github.com\/HaishinKit\/HaishinKit.swift\/discussions\/1672","type":"reference"},{"text":", support for CocoaPods has been discontinued.","type":"text"}]},{"anchor":"20x","text":"2.0.x","type":"heading","level":5},{"items":[{"content":[{"inlineContent":[{"text":"CocoaPods","type":"text"}],"type":"paragraph"}],"checked":true},{"content":[{"inlineContent":[{"text":"SwiftPM","type":"text"}],"type":"paragraph"}],"checked":true}],"type":"unorderedList"},{"anchor":"210","text":"2.1.0","type":"heading","level":5},{"items":[{"content":[{"inlineContent":[{"text":"SwiftPM","type":"text"}],"type":"paragraph"}],"checked":true}],"type":"unorderedList"},{"anchor":"MediaMixer","text":"MediaMixer","type":"heading","level":3},{"anchor":"Change-in-behavior","text":"Change in behavior","type":"heading","level":4},{"type":"paragraph","inlineContent":[{"text":"Since around iOS 18, when attaching a device during capture with AVCaptureMultiCamSession, the application’s UI becomes locked for several seconds. To address this, we have changed the behavior to start capture manually.","type":"text"}]},{"anchor":"20x","text":"2.0.x","type":"heading","level":5},{"syntax":"swift","code":["import HaishinKit","","let mixer = MediaMixer()","\/\/ Capture was automatically started under certain conditions.","await mixer.attachVideo(AVCaptureDevice.default(.builtInWideAngleCamera, for: .video, position: .back))","await mixer.addOutput(view)"],"type":"codeListing"},{"anchor":"210","text":"2.1.0","type":"heading","level":5},{"syntax":"swift","code":["import HaishinKit","","let mixer = MediaMixer()","await mixer.attachVideo(AVCaptureDevice.default(.builtInWideAngleCamera, for: .video, position: .back))","await mixer.addOutput(view)","","\/\/ Calling startRunning() is now required.","await mixer.startRunning()"],"type":"codeListing"},{"anchor":"frameRate","text":"frameRate","type":"heading","level":4},{"type":"paragraph","inlineContent":[{"text":"Frame rate specification has been changed to allow separate settings for output configuration and camera input.","type":"text"}]},{"anchor":"20x","text":"2.0.x","type":"heading","level":5},{"syntax":"swift","code":["await mixer.setFrameRate(fps)"],"type":"codeListing"},{"anchor":"210","text":"2.1.0","type":"heading","level":5},{"syntax":"swift","code":["\/\/ Sets to video camera capture frameRate.","try? await mixer.configuration(video: 0) { video in","  do {","    try video.setFrameRate(fps)","  } catch {","    logger.error(error)","  }","}","","\/\/ Sets to output frameRate.","try await mixer.setFrameRate(fps)"],"type":"codeListing"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/HaishinKit\/documentation\/HaishinKit\/migration-2.0.x-to-2.1.0"},"hierarchy":{"paths":[["doc:\/\/HaishinKit\/documentation\/HaishinKit","doc:\/\/HaishinKit\/documentation\/HaishinKit\/migration-guide"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"seeAlsoSections":[{"generated":true,"title":"Migrating to 2.x","identifiers":["doc:\/\/HaishinKit\/documentation\/HaishinKit\/migration-2.2.x-to-2.3.x","doc:\/\/HaishinKit\/documentation\/HaishinKit\/migration-1.9.x-to-2.0.0"],"anchor":"Migrating-to-2x"}],"metadata":{"role":"article","title":"Moving from 2.0.x APIs to 2.1.0","roleHeading":"Article","modules":[{"name":"HaishinKit"}]},"kind":"article","sections":[],"references":{"doc://HaishinKit/documentation/HaishinKit/migration-1.9.x-to-2.0.0":{"kind":"article","identifier":"doc:\/\/HaishinKit\/documentation\/HaishinKit\/migration-1.9.x-to-2.0.0","role":"article","abstract":[{"text":"Update code written for HaishinKit 1.9.x to use the 2.0.0 APIs.","type":"text"}],"title":"Moving from 1.9.x APIs to 2.0.0","type":"topic","url":"\/documentation\/haishinkit\/migration-1.9.x-to-2.0.0"},"https://github.com/HaishinKit/HaishinKit.swift/discussions/1672":{"type":"link","identifier":"https:\/\/github.com\/HaishinKit\/HaishinKit.swift\/discussions\/1672","titleInlineContent":[{"text":"As previously announced","type":"text"}],"title":"As previously announced","url":"https:\/\/github.com\/HaishinKit\/HaishinKit.swift\/discussions\/1672"},"doc://HaishinKit/documentation/HaishinKit/migration-guide":{"title":"Migration Guide","kind":"article","identifier":"doc:\/\/HaishinKit\/documentation\/HaishinKit\/migration-guide","url":"\/documentation\/haishinkit\/migration-guide","abstract":[{"type":"text","text":"Find the API changes and code examples 