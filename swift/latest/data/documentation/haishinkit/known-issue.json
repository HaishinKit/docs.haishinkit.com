{"sections":[],"primaryContentSections":[{"content":[{"type":"heading","anchor":"%F0%9F%94%8D-Overview","text":"🔍 Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"This section lists known issues that cannot be resolved within HaishinKit. It mainly summarizes problems that occur during development with Xcode."}]},{"type":"heading","anchor":"When-Debugging-with-Xcode","text":"When Debugging with Xcode","level":3},{"type":"paragraph","inlineContent":[{"text":"The following issues may occur while developing with Xcode connected.","type":"text"}]},{"type":"heading","anchor":"Application-Freezes-on-Launch","text":"Application Freezes on Launch","level":4},{"type":"paragraph","inlineContent":[{"type":"text","text":"When "},{"type":"codeVoice","code":"MediaMixer#startRunning()"},{"type":"text","text":" is executed while the app is launched from Xcode, the application may freeze."},{"type":"text","text":" "},{"type":"text","text":"It has been confirmed that this does not occur when the application is force-quit and then relaunched."}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"iOS18, Xcode16 The issue is still ongoing in the latest version."}]}]}]},{"type":"heading","level":4,"text":"Freeze When Starting Recording","anchor":"Freeze-When-Starting-Recording"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When "},{"code":"StreamRecorder#startRecording()","type":"codeVoice"},{"type":"text","text":" is executed while the app is launched from Xcode, the application may freeze."},{"type":"text","text":" "},{"type":"text","text":"It has been confirmed that this does not occur when the application is force-quit and then relaunched."}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"iOS18, Xcode16 The issue is still ongoing in the latest version."}],"type":"paragraph"}]}]}],"kind":"content"}],"kind":"article","variants":[{"traits":[{"inter