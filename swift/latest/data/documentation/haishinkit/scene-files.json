{"abstract":[{"type":"text","text":"Save a ScreenObjectSnapshot and its media in one portable file."}],"variants":[{"paths":["\/documentation\/haishinkit\/scene-files"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"content":[{"type":"heading","text":"File format","anchor":"File-format","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":".scene"},{"type":"text","text":" file is a regular ZIP containing:"}]},{"items":[{"content":[{"inlineContent":[{"code":"scene.json","type":"codeVoice"},{"text":": a camelCase ","type":"text"},{"identifier":"doc:\/\/HaishinKit\/documentation\/HaishinKit\/ScreenObjectSnapshot","isActive":true,"type":"reference"},{"text":" object, without an envelope.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"manifest.json","type":"codeVoice"},{"text":": ","type":"text"},{"code":"{\"format\":\"haishinkit.scene\",\"version\":1}","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"media\/<filename>","type":"codeVoice"},{"text":": bundled images, video, or resources for future object types.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Readers accept ZIP STORE and DEFLATE entries, including streamed ZIP data descriptors."},{"type":"text","text":" "},{"type":"text","text":"They also accept standalone snapshot JSON when no external media is needed."},{"type":"text","text":" "},{"type":"text","text":"Resource names are flat filenames, unique under the shared conservative case key"},{"type":"text","text":" "},{"type":"text","text":"(NFC, lowercase, uppercase, lowercase, NFC; Unicode default\/ROOT casing); absolute paths and traversal are rejected."},{"type":"text","text":" "},{"type":"text","text":"The limits are 128 MiB of resources, 256 resources, and 4 MiB of snapshot JSON."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The snapshot retains "},{"type":"codeVoice","code":"type"},{"type":"text","text":", "},{"type":"codeVoice","code":"id"},{"type":"text","text":", "},{"type":"codeVoice","code":"size"},{"type":"text","text":", "},{"type":"codeVoice","code":"isVisible"},{"type":"text","text":", "},{"type":"codeVoice","code":"layoutMargin"},{"type":"text","text":", horizontal"},{"type":"text","text":" "},{"type":"text","text":"and vertical alignment, "},{"type":"codeVoice","code":"elements"},{"type":"text","text":", "},{"type":"codeVoice","code":"children"},{"type":"text","text":", and optional "},{"type":"codeVoice","code":"cornerRadius"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Object-specific properties stay in the string-valued "},{"type":"codeVoice","code":"elements"},{"type":"text","text":" map. Images and"},{"type":"text","text":" "},{"type":"text","text":"assets reference bundled media with "},{"type":"codeVoice","code":"source: \"media\/<filename>\""},{"type":"text","text":". Inline image"},{"type":"text","text":" "},{"type":"text","text":"data URLs remain supported. Video gravity values are "},{"type":"codeVoice","code":"resize"},{"type":"text","text":", "},{"type":"codeVoice","code":"resizeAspect"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"resizeAspectFill"},{"type":"text","text":"; an omitted value means "},{"type":"codeVoice","code":"resizeAspect"},{"type":"text","text":"."}]},{"type":"heading","text":"Save and load","anchor":"Save-and-load","level":2},{"syntax":"swift","type":"codeListing","code":["let snapshot = ScreenObjectSnapshotFactory().make(screenObject)","let sceneFile = try SceneFile(snapshot: snapshot, resources: [\"overlay.png\": imageData])","try sceneFile.encoded().write(to: destination, options: .atomic)","let restored = try SceneFile(data: Data(contentsOf: destination))"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Before saving, use relative media references, or supply resources named after the"},{"type":"text","text":" "},{"type":"text","text":"local file URL’s last path component; the scene file converts matching image\/asset"},{"type":"text","text":" "},{"type":"text","text":"file URLs to portable references. After loading, materialize resources in app"},{"type":"text","text":" "},{"type":"text","text":"storage and replace known media references with those local file URLs before"},{"type":"text","text":" "},{"type":"text","text":"passing the snapshot to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HaishinKit\/documentation\/HaishinKit\/ScreenObjectFactory"},{"type":"text","text":". The scene file does not open"},{"type":"text","text":" "},{"type":"text","text":"capture devices, request permissions, or restore transport credentials."}]},{"type":"heading","text":"Unsupported objects","anchor":"Unsupported-objects","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"An unsupported type produces an invisible placeholder. Snapshot capture returns"},{"type":"text","text":" "},{"type":"text","text":"its original type, properties, visibility intent, and subtree so another platform"},{"type":"text","text":" "},{"type":"text","text":"can restore it later. Do not discard opaque objects or their bundled resources"},{"type":"text","text":" "},{"type":"text","text":"when editing or exporting. A saved "},{"type":"codeVoice","code":"isVisible: true"},{"type":"text","text":" remains true even when the"},{"type":"text","text":" "},{"type":"text","text":"current platform cannot draw the object. Readers without video-file support"},{"type":"text","text":" "},{"type":"text","text":"keep "},{"type":"codeVoice","code":"asset"},{"type":"text","text":" objects this way."}]},{"type":"paragraph","inlineContent":[{"text":"The macOS example uses this format for Open\/Export and keeps lightweight snapshot","type":"text"},{"text":" ","type":"text"},{"text":"JSON plus scene-specific media caches for automatic local saves.","type":"text"}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/HaishinKit\/documentation\/HaishinKit"]]},"identifier":{"url":"doc:\/\/HaishinKit\/documentation\/HaishinKit\/scene-files","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"role":"article","modules":[{"name":"HaishinKit"}],"title":"Portable scene files","roleHeading":"Article"},"kind":"article","sections":[],"references":{"haishinkit-card.svg":{"type":"image","identifier":"haishinkit-card.svg","alt":"HaishinKit app icon","variants":[{"url":"\/images\/HaishinKit\/haishinkit-card.svg","traits":["1x","light"]}]},"doc://HaishinKit/documentation/HaishinKit/ScreenObjectSnapshot":{"navigatorTitle":[{"kind":"identifier","text":"ScreenObjectSnapshot"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ScreenObjectSnapshot"}],"identifier":"doc:\/\/HaishinKit\/documentation\/HaishinKit\/ScreenObjectSnapshot","title":"ScreenObjectSnapshot","url":"\/documentation\/haishinkit\/screenobjectsnapshot","kind":"symbol","abstract":[{"type":"text","text":"A snapshot representation of a screen object."}],"role":"symbol","type":"topic"},"doc://HaishinKit/documentation/HaishinKit/ScreenObjectFactory":{"type":"topic","identifier":"doc:\/\/HaishinKit\/documentation\/HaishinKit\/ScreenObjectFactory","kind":"symbol","url":"\/documentation\/haishinkit\/screenobjectfactory","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ScreenObjectFactory","kind":"identifier"}],"navigatorTitle":[{"text":"ScreenObjectFactory","kind":"identifier"}],"abstract":[{"text":"A factory responsible for creating ","type":"text"},{"code":"ScreenObject","type":"codeVoice"},{"text":" instances","type":"text"},{"text":" ","type":"text"},{"text":"from a ","type":"text"},{"code":"ScreenObjectSnapshot","type":"codeVoice"},{"text":".","type":"text"}],"title":"ScreenObjectFactory"},"haishinkit-app-icon.png":{"type":"image","identifier":"haishinkit-app-icon.png","alt":"HaishinKit app icon","variants":[{"url":"\/images\/HaishinKit\/haishinkit-app-icon.png","traits":["1x","light"]}]},"doc://HaishinKit/documentation/HaishinKit":{"identifier":"doc:\/\/HaishinKit\/documentation\/HaishinKit","abstract":[{"type":"text","text":"This is the main module."}],"type":"topic","role":"collection","url":"\/documentation\/haishinkit","kind":"symbol","images":[{"identifier":"haishinkit-app-icon.png","type":"icon"},{"identifier":"haishinkit-card.svg","type":"card"}],"title":"HaishinKit"}}}