{"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"paths":["\/documentation\/haishinkit\/macos-debug-app"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/HaishinKit\/documentation\/HaishinKit"]]},"sections":[],"abstract":[{"text":"Exercise capture, encoding, transport, and playback in the macOS Example app.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"text":"Run the app","anchor":"Run-the-app","type":"heading","level":2},{"inlineContent":[{"text":"Open ","type":"text"},{"code":"Examples\/Examples.xcworkspace","type":"codeVoice"},{"text":" and run the ","type":"text"},{"code":"Example macOS","type":"codeVoice"},{"text":" scheme. The","type":"text"},{"text":" ","type":"text"},{"text":"workspace uses the library in the same checkout. Release ZIPs target Apple","type":"text"},{"text":" ","type":"text"},{"text":"Silicon and require macOS 15.5 or later.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Publish and inspect","type":"heading","anchor":"Publish-and-inspect"},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"inlineContent":[{"text":"Publish","type":"text"}],"type":"strong"},{"text":" for a camera preview, screen sharing, scene overlay editing,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"frame-rate changes, and monochrome effects. "},{"type":"strong","inlineContent":[{"text":"Encoder","type":"text"}]},{"type":"text","text":" controls set the output"},{"text":" ","type":"text"},{"text":"resolution, codec, video\/audio target bitrates, and hardware encoding for the","type":"text"},{"text":" ","type":"text"},{"text":"next publishing session. ","type":"text"},{"inlineContent":[{"text":"Settings","type":"text"}],"type":"strong"},{"text":" contains audio format, bitrate mode, and","type":"text"},{"text":" ","type":"text"},{"text":"low-latency options.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The preview canvas is 1280 × 720; encoder output resolution is configured","type":"text"},{"text":" ","type":"text"},{"text":"separately. Target video bitrate is a setting, not a measured throughput value.","type":"text"},{"text":" ","type":"text"},{"text":"Measured TX and send queue use transport reports where the selected protocol","type":"text"},{"text":" ","type":"text"},{"text":"provides them. Output FPS is currently available for RTMP. A dash means a","type":"text"},{"text":" ","type":"text"},{"text":"measurement is unavailable, including before a session starts.","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Share screen or window…","type":"text"}],"type":"strong"},{"text":" opens the system ScreenCaptureKit picker. Choose a","type":"text"},{"text":" ","type":"text"},{"text":"display, window, or application. Captured video replaces the camera on mixer","type":"text"},{"text":" ","type":"text"},{"text":"track 0; overlays and effects still apply. Audio continues to come from the","type":"text"},{"text":" ","type":"text"},{"text":"microphone when enabled in ","type":"text"},{"inlineContent":[{"text":"Settings → Capture","type":"text"}],"type":"strong"},{"text":". Microphone capture is off by","type":"text"},{"text":" ","type":"text"},{"text":"default so video-only debugging does not open an audio device. Camera and","type":"text"},{"text":" ","type":"text"},{"text":"microphone access must be granted before their capture devices are opened.","type":"text"},{"text":" ","type":"text"},{"type":"strong","inlineContent":[{"text":"Stop sharing · Use camera","type":"text"}]},{"text":" restores authorized camera capture. Sharing stops","type":"text"},{"text":" ","type":"text"},{"text":"when the publishing view closes.","type":"text"}]},{"type":"heading","level":2,"anchor":"Receive-SRT-on-the-local-network","text":"Receive SRT on the local network"},{"type":"paragraph","inlineContent":[{"text":"In ","type":"text"},{"inlineContent":[{"text":"Playback","type":"text"}],"type":"strong"},{"text":", enter a receive port and choose ","type":"text"},{"inlineContent":[{"type":"text","text":"Listen for SRT sender"}],"type":"strong"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"After the SRT socket is listening, the app announces a Bonjour service:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Type: "},{"type":"codeVoice","code":"_srt._udp."},{"type":"text","text":" in "},{"type":"codeVoice","code":"local."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Port: the selected SRT port."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"TXT: "},{"type":"codeVoice","code":"role=receiver"},{"type":"text","text":", "},{"type":"codeVoice","code":"version=1"},{"type":"text","text":"."}]}]}]},{"type":"paragraph","inlineContent":[{"text":"The sending client resolves the service address and connects using","type":"text"},{"text":" ","type":"text"},{"code":"srt:\/\/<resolved-host>:<port>?mode=caller","type":"codeVoice"},{"text":", sending MPEG-TS with supported","type":"text"},{"text":" ","type":"text"},{"text":"video\/audio codecs. One sender is accepted per listener. The announcement is","type":"text"},{"text":" ","type":"text"},{"text":"removed once a sender connects or listening stops. Choose ","type":"text"},{"inlineContent":[{"text":"Cancel receiving","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"text":"to stop waiting, or ","type":"text"},{"inlineContent":[{"text":"Stop playback","type":"text"}],"type":"strong"},{"text":" to close an established connection.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For a local smoke test, start listening on port 9000 and send a generated test","type":"text"},{"text":" ","type":"text"},{"text":"pattern with FFmpeg built with SRT support:","type":"text"}]},{"type":"codeListing","syntax":"sh","code":["ffmpeg -re -f lavfi -i testsrc2=size=640x360:rate=30 \\","  -f lavfi -i sine=frequency=440:sample_rate=48000 \\","  -c:v libx264 -preset ultrafast -tune zerolatency -pix_fmt yuv420p \\","  -c:a aac -f mpegts 'srt:\/\/127.0.0.1:9000?mode=caller'"]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Find Bonjour services","type":"text"}],"type":"strong"},{"text":" searches for ","type":"text"},{"code":"_srt._udp","type":"codeVoice"},{"text":" sources and connects in","type":"text"},{"text":" ","type":"text"},{"text":"caller\/playback mode. Receiver-only advertisements are excluded from the source","type":"text"},{"text":" ","type":"text"},{"text":"list. Bonjour discovery is an opt-in convention used by this example; arbitrary","type":"text"},{"text":" ","type":"text"},{"text":"SRT servers do not automatically advertise themselves. Local network access","type":"text"},{"text":" ","type":"text"},{"text":"must be allowed, and both peers must be on a network that permits mDNS and SRT.","type":"text"}]},{"type":"heading","level":2,"anchor":"Debug-tools-and-HTTP-signaling","text":"Debug tools and HTTP signaling"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Debug","type":"text"}],"type":"strong"},{"text":" provides verbose library logging and a publish-view sheet for repeated","type":"text"},{"text":" ","type":"text"},{"text":"open\/dismiss memory-release checks with Instruments. Debug logs can contain","type":"text"},{"text":" ","type":"text"},{"text":"endpoint URLs and signaling data.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The WHIP\/WHEP presets construct client endpoints for a separately running","type":"text"},{"text":" ","type":"text"},{"text":"MediaMTX server. WHIP selects Opus audio. MediaMTX setup and WebRTC network","type":"text"},{"text":" ","type":"text"},{"text":"requirements are documented in the ","type":"text"},{"identifier":"https:\/\/mediamtx.org\/docs\/features\/publish-and-read","isActive":true,"type":"reference"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"The example permits plain HTTP to support local test servers; configure secure","type":"text"},{"text":" ","type":"text"},{"text":"transport and authentication separately for production applications.","type":"text"}]}]}],"identifier":{"url":"doc:\/\/HaishinKit\/documentation\/HaishinKit\/macOS-debug-app","interfaceLanguage":"swift"},"metadata":{"modules":[{"name":"HaishinKit"}],"roleHeading":"Article","title":"macOS debug application","role":"article"},"kind":"article","references":{"doc://HaishinKit/documentation/HaishinKit":{"url":"\/documentation\/haishinkit","title":"HaishinKit","role":"collection","images":[{"type":"icon","identifier":"haishinkit-app-icon.png"},{"identifier":"haishinkit-card.svg","type":"card"}],"abstract":[{"type":"text","text":"This is the main module."}],"type":"topic","kind":"symbol","identifier":"doc:\/\/HaishinKit\/documentation\/HaishinKit"},"haishinkit-card.svg":{"identifier":"haishinkit-card.svg","type":"image","alt":"HaishinKit app icon","variants":[{"url":"\/images\/HaishinKit\/haishinkit-card.svg","traits":["1x","light"]}]},"haishinkit-app-icon.png":{"identifier":"haishinkit-app-icon.png","type":"image","alt":"HaishinKit app icon","variants":[{"url":"\/images\/HaishinKit\/haishinkit-app-icon.png","traits":["1x","light"]}]},"https://mediamtx.org/docs/features/publish-and-read":{"identifier":"https:\/\/mediamtx.org\/docs\/features\/publish-and-read","type":"link","title":"MediaMTX reference","titleInlineContent":[{"text":"MediaMTX reference","type":"text"}],"url":"https:\/\/mediamtx.org\/docs\/features\/publish-and-read"}}}