{"abstract":[{"text":"Receive streams or send a generated test signal from the ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Example visionOS"}]},{"type":"text","text":" scheme"},{"type":"text","text":" "},{"type":"text","text":"in "},{"type":"codeVoice","code":"Examples\/Examples.xcworkspace"},{"type":"text","text":"."}],"variants":[{"paths":["\/documentation\/haishinkit\/visionos-studio"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Receive a stream","level":2,"anchor":"Receive-a-stream"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Choose "},{"inlineContent":[{"text":"Receive","type":"text"}],"type":"strong"},{"type":"text","text":", then "},{"inlineContent":[{"text":"Connection","type":"text"}],"type":"strong"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Enter an RTMP\/RTMPS server URL and a stream name, or a complete SRT URL with a port."},{"type":"text","text":" "},{"type":"text","text":"A signed RTMP stream name may include a query (for example, "},{"code":"stream?token=...","type":"codeVoice"},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"Server URL query items are kept first, followed by stream-name query items."},{"type":"text","text":" "},{"type":"text","text":"The server URL accepts one application path component, such as "},{"code":"\/live","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Put nested stream paths such as "},{"type":"codeVoice","code":"group\/camera"},{"type":"text","text":" in "},{"type":"strong","inlineContent":[{"text":"Stream name \/ key","type":"text"}]},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Application\/instance server paths are not supported by this sample."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Close the connection panel and press "},{"inlineContent":[{"type":"text","text":"Play"}],"type":"strong"},{"type":"text","text":". Press "},{"inlineContent":[{"type":"text","text":"Stop"}],"type":"strong"},{"type":"text","text":" before changing modes or endpoints."}]}]}]},{"type":"paragraph","inlineContent":[{"text":"SRT socket options belong in the URL query. For example, a receiver connecting to","type":"text"},{"text":" ","type":"text"},{"text":"an existing SRT listener can use ","type":"text"},{"code":"srt:\/\/192.168.1.10:9710?mode=caller","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"This studio uses SRT caller connections only. Listener, rendezvous and local adapter","type":"text"},{"text":" ","type":"text"},{"text":"binding are not supported here. The tvOS studio also offers listener mode.","type":"text"}]},{"type":"heading","text":"Broadcast a test signal","level":2,"anchor":"Broadcast-a-test-signal"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Choose "},{"inlineContent":[{"type":"text","text":"Test broadcast"}],"type":"strong"},{"type":"text","text":". The idle preview shows the test pattern."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Open "},{"inlineContent":[{"type":"text","text":"Connection"}],"type":"strong"},{"type":"text","text":" and enter the receiving server\/peer’s address."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Press "},{"inlineContent":[{"type":"text","text":"Broadcast"}],"type":"strong"},{"type":"text","text":". The generated image moves while the connection is active."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Press "},{"inlineContent":[{"type":"text","text":"Stop"}],"type":"strong"},{"type":"text","text":" to close the connection and stop generating media."}]}]}]},{"type":"paragraph","inlineContent":[{"text":"The source is 1280 × 720 at 30 fps, encoded as H.264 at 2.5 Mbps with AAC audio","type":"text"},{"text":" ","type":"text"},{"text":"at 48 kHz \/ 128 kbps. The stereo test tone is 440 Hz on the left and 880 Hz on","type":"text"},{"text":" ","type":"text"},{"text":"the right. It is sent to the stream, not played through the local speakers.","type":"text"},{"text":" ","type":"text"},{"text":"No camera or microphone is opened and no capture permission is needed.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The simulator requests software video encoding; actual encoder availability and","type":"text"},{"text":" ","type":"text"},{"text":"performance depend on the OS\/device. See ","type":"text"},{"identifier":"doc:\/\/HaishinKit\/documentation\/HaishinKit\/codec-support","type":"reference","isActive":true},{"text":" for capability reports.","type":"text"}]},{"type":"heading","text":"Window controls","level":2,"anchor":"Window-controls"},{"type":"paragraph","inlineContent":[{"text":"The main window separates video from connection controls. ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Fill video"}]},{"text":" in the","type":"text"},{"text":" ","type":"text"},{"text":"lower glass toolbar switches between fitting the complete image and filling the","type":"text"},{"text":" ","type":"text"},{"text":"view (which may crop it). ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Device codecs"}]},{"text":" opens the system capability report,","type":"text"},{"text":" ","type":"text"},{"text":"including its clipboard action.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Connection fields remain in memory for the current window. The selected mode is","type":"text"},{"text":" ","type":"text"},{"text":"remembered between launches. Main-window source labels omit stream keys,","type":"text"},{"text":" ","type":"text"},{"text":"credentials and URL query options. Closing the window stops its session.","type":"text"}]},{"type":"heading","text":"Camera access","level":2,"anchor":"Camera-access"},{"type":"paragraph","inlineContent":[{"text":"This example does not capture the Apple Vision Pro’s main camera. Apple’s","type":"text"},{"text":" ","type":"text"},{"identifier":"https:\/\/developer.apple.com\/documentation\/visionos\/accessing-the-main-camera","type":"reference","isActive":true},{"text":" ","type":"text"},{"text":"is an enterprise API requiring a separately approved entitlement. Synthetic test","type":"text"},{"text":" ","type":"text"},{"text":"signals allow publishing to be exercised without that entitlement.","type":"text"}]},{"type":"heading","text":"Pending RTMP connections","level":2,"anchor":"Pending-RTMP-connections"},{"type":"paragraph","inlineContent":[{"text":"A TCP server that accepts a connection without replying to the RTMP handshake can","type":"text"},{"text":" ","type":"text"},{"text":"leave the current shared session waiting indefinitely. Closing a pending session","type":"text"},{"text":" ","type":"text"},{"text":"is a known transport limitation being addressed separately; this studio does not","type":"text"},{"text":" ","type":"text"},{"text":"add a per-window handshake deadline.","type":"text"}]}]}],"identifier":{"url":"doc:\/\/HaishinKit\/documentation\/HaishinKit\/visionos-studio","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/HaishinKit\/documentation\/HaishinKit"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"seeAlsoSections":[{"anchor":"Example-applications","generated":true,"title":"Example applications","identifiers":["doc:\/\/HaishinKit\/documentation\/HaishinKit\/macOS-debug-app","doc:\/\/HaishinKit\/documentation\/HaishinKit\/codec-support"]}],"metadata":{"modules":[{"name":"HaishinKit"}],"role":"article","title":"Using the visionOS sample studio","roleHeading":"Article"},"kind":"article","sections":[],"references":{"doc://HaishinKit/documentation/HaishinKit/macOS-debug-app":{"kind":"article","identifier":"doc:\/\/HaishinKit\/documentation\/HaishinKit\/macOS-debug-app","role":"article","abstract":[{"text":"Exercise capture, encoding, transport, and playback in the macOS Example app.","type":"text"}],"title":"macOS debug application","type":"topic","url":"\/documentation\/haishinkit\/macos-debug-app"},"doc://HaishinKit/documentation/HaishinKit/codec-support":{"abstract":[{"type":"text","text":"Inspect OS-reported video and audio capabilities in the iOS, macOS, tvOS and"},{"type":"text","text":" "},{"type":"text","text":"visionOS example applications. The inspector uses the system APIs; it does not"},{"type":"text","text":" "},{"type":"text","text":"include bundled AOM\/VPX implementations or establish support in a streaming protocol."}],"identifier":"doc:\/\/HaishinKit\/documentation\/HaishinKit\/codec-support","title":"Checking system codec support","type":"topic","role":"article","kind":"article","url":"\/documentation\/haishinkit\/codec-support"},"doc://HaishinKit/documentation/HaishinKit":{"identifier":"doc:\/\/HaishinKit\/documentation\/HaishinKit","abstract":[{"type":"text","text":"This is the main module."}],"type":"topic","role":"collection","url":"\/documentation\/haishinkit","kind":"symbol","images":[{"identifier":"haishinkit-app-icon.png","type":"icon"},{"identifier":"haishinkit-card.svg","type":"card"}],"title":"HaishinKit"},"haishinkit-app-icon.png":{"type":"image","alt":"HaishinKit app icon","identifier":"haishinkit-app-icon.png","variants":[{"url":"\/images\/HaishinKit\/haishinkit-app-icon.png","traits":["1x","light"]}]},"haishinkit-card.svg":{"type":"image","alt":"HaishinKit app icon","identifier":"haishinkit-card.svg","variants":[{"url":"\/images\/HaishinKit\/haishinkit-card.svg","traits":["1x","light"]}]},"https://developer.apple.com/documentation/visionos/accessing-the-main-camera":{"url":"https:\/\/developer.apple.com\/documentation\/visionos\/accessing-the-main-camera","titleInlineContent":[{"type":"text","text":"main camera access"}],"tit