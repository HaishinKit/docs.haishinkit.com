{"kind":"article","hierarchy":{"paths":[["doc:\/\/HaishinKit\/documentation\/HaishinKit"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/HaishinKit\/documentation\/HaishinKit\/codec-support"},"sections":[],"abstract":[{"text":"Inspect OS-reported video and audio capabilities in the iOS, macOS, tvOS and","type":"text"},{"text":" ","type":"text"},{"text":"visionOS example applications. The inspector uses the system APIs; it does not","type":"text"},{"text":" ","type":"text"},{"text":"include bundled AOM\/VPX implementations or establish support in a streaming protocol.","type":"text"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"seeAlsoSections":[{"anchor":"Example-applications","identifiers":["doc:\/\/HaishinKit\/documentation\/HaishinKit\/macOS-debug-app","doc:\/\/HaishinKit\/documentation\/HaishinKit\/visionos-studio"],"title":"Example applications","generated":true}],"metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"HaishinKit"}],"title":"Checking system codec support"},"primaryContentSections":[{"content":[{"anchor":"Open-the-inspector","level":2,"text":"Open the inspector","type":"heading"},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Sample"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Location"}]}]],[[{"inlineContent":[{"text":"iOS","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Preference → Device codecs"}]}]],[[{"inlineContent":[{"text":"macOS","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Settings → Device codecs"}]}]],[[{"inlineContent":[{"text":"tvOS","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Settings → Settings tab → Device codecs"}]}]],[[{"inlineContent":[{"text":"visionOS","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Device codecs in the toolbar below the playback view"}]}]]],"header":"row","type":"table"},{"inlineContent":[{"text":"The screen has Video and Audio lists, separate encoding and decoding information,","type":"text"},{"text":" ","type":"text"},{"text":"and expandable format identifiers. Refresh reads the current process’s reported","type":"text"},{"text":" ","type":"text"},{"text":"capabilities again while keeping the current list visible. The capability queries do not open a camera, microphone, audio session or network connection.","type":"text"}],"type":"paragraph"},{"anchor":"Copy-a-report","level":2,"text":"Copy a report","type":"heading"},{"inlineContent":[{"type":"text","text":"On iOS, macOS and visionOS, "},{"type":"strong","inlineContent":[{"type":"text","text":"Copy"}]},{"type":"text","text":" writes the complete Video and Audio report,"},{"type":"text","text":" "},{"type":"text","text":"including encoder implementation details, query errors, OS\/platform information and"},{"type":"text","text":" "},{"type":"text","text":"interpretation limits, to the system clipboard. Both categories are copied even"},{"type":"text","text":" "},{"type":"text","text":"when only one is visible. Field labels use English so reports can be compared"},{"type":"text","text":" "},{"type":"text","text":"across app languages. Copying happens only when the button is pressed."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The tvOS SDK does not expose a public clipboard API. That sample shows an"},{"type":"text","text":" "},{"type":"text","text":"explanation instead of a Copy action."}],"type":"paragraph"},{"anchor":"VideoToolbox","level":2,"text":"VideoToolbox","type":"heading"},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"https:\/\/developer.apple.com\/documentation\/videotoolbox\/vtcopyvideoencoderlist(_:_:)"},{"type":"text","text":" "},{"type":"text","text":"returns registered encoder implementations. The inspector displays their names,"},{"type":"text","text":" "},{"type":"text","text":"identifiers and reported hardware\/software classification. It requests"},{"type":"text","text":" "},{"type":"codeVoice","code":"kVTVideoEncoderListOption_IncludeStandardDefinitionDVEncoders"},{"type":"text","text":" so installed"},{"type":"text","text":" "},{"type":"text","text":"standard-definition DV encoders are included. A missing acceleration"},{"type":"text","text":" "},{"type":"text","text":"flag remains unspecified. Absence from a successful list is shown as "},{"type":"strong","inlineContent":[{"type":"text","text":"Not listed"}]},{"type":"text","text":";"},{"type":"text","text":" "},{"type":"text","text":"a failed query is shown as "},{"type":"strong","inlineContent":[{"type":"text","text":"Unknown"}]},{"type":"text","text":", with its error status."}],"type":"paragraph"},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"https:\/\/developer.apple.com\/documentation\/videotoolbox\/vtishardwaredecodesupported(_:)"},{"type":"text","text":" "},{"type":"text","text":"only answers the hardware-decoding question. The inspector queries seven selected"},{"type":"text","text":" "},{"type":"text","text":"common codec types (H.264, HEVC, AV1, VP9, ProRes 422, ProRes 4444 and JPEG), plus"},{"type":"text","text":" "},{"type":"text","text":"any types returned by encoder enumeration. This is not a complete decoder inventory;"},{"type":"text","text":" "},{"type":"text","text":"formats outside that set are not queried. A negative result does not rule out"},{"type":"text","text":" "},{"type":"text","text":"software decoding. The "},{"type":"strong","inlineContent":[{"type":"text","text":"Hardware decode"}]},{"type":"text","text":" column therefore uses "},{"type":"strong","inlineContent":[{"type":"text","text":"Not reported"}]},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"not a general “codec unsupported” result. The inspector does not create decoding"},{"type":"text","text":" "},{"type":"text","text":"sessions with incomplete format descriptions, which could otherwise give false"},{"type":"text","text":" "},{"type":"text","text":"negative results for formats requiring parameter sets or other initialization data."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Encoder enumeration does not guarantee that a compression session can be created"},{"type":"text","text":" "},{"type":"text","text":"with every profile, resolution, frame rate, latency setting or concurrent workload."},{"type":"text","text":" "},{"type":"text","text":"Session creation and actual frame processing are separate checks. Simulator results"},{"type":"text","text":" "},{"type":"text","text":"can reflect host\/simulator facilities and must not be treated as physical-device results."}],"type":"paragraph"},{"anchor":"AudioConverter-and-AVAudioConverter","level":2,"text":"AudioConverter and AVAudioConverter","type":"heading"},{"inlineContent":[{"type":"text","text":"The audio list reads "},{"type":"codeVoice","code":"kAudioFormatProperty_EncodeFormatIDs"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"kAudioFormatProperty_DecodeFormatIDs"},{"type":"text","text":" through "},{"type":"codeVoice","code":"AudioFormatGetPropertyInfo"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"AudioFormatGetProperty"},{"type":"text","text":". These are the system-reported valid output\/input format"},{"type":"text","text":" "},{"type":"text","text":"IDs for AudioConverter. See Apple’s"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"https:\/\/developer.apple.com\/documentation\/audiotoolbox\/1577853-audio-format-property-identifier"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"Listed","type":"text"}],"type":"strong"},{"type":"text","text":" is a format-level report. It does not promise every conversion between"},{"type":"text","text":" "},{"type":"text","text":"listed formats. An "},{"type":"reference","identifier":"https:\/\/developer.apple.com\/documentation\/avfaudio\/avaudioconverter","isActive":true},{"type":"text","text":" "},{"type":"text","text":"still needs concrete input and output formats, sample rates, channel layouts and"},{"type":"text","text":" "},{"type":"text","text":"codec settings. Some compressed inputs also need a magic cookie. Creating a"},{"type":"text","text":" "},{"type":"text","text":"converter is itself only a construction check; successful conversion requires"},{"type":"text","text":" "},{"type":"text","text":"supplying valid data and checking conversion status and errors."}],"type":"paragraph"},{"inlineContent":[{"text":"For example, a PCM-to-AAC construction check can use:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import AVFAudio","import AudioToolbox","","let pcm = AVAudioFormat(","    commonFormat: .pcmFormatFloat32,","    sampleRate: 48_000,","    channels: 2,","    interleaved: false",")","let aac = AVAudioFormat(settings: [","    AVFormatIDKey: kAudioFormatMPEG4AAC,","    AVSampleRateKey: 48_000,","    AVNumberOfChannelsKey: 2","])","if let pcm, let aac, let converter = AVAudioConverter(from: pcm, to: aac) {","    \/\/ Construction succeeded for this format pair on this OS\/device.","    \/\/ Next, supply valid PCM buffers to convert(to:error:withInputFrom:)","    \/\/ and check its returned status and error. No conversion has happened yet.","    print(converter.outputFormat)","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The sample inspector deliberately does not allocate converters or encode\/decode"},{"type":"text","text":" "},{"type":"text","text":"probe frames for every entry. It keeps the list distinct from a conversion test"},{"type":"text","text":" "},{"type":"text","text":"and avoids reserving scarce codec instances while a stream may already be running."},{"type":"text","text":" "},{"type":"text","text":"Use an actual converter\/session and representative data to validate the particular"},{"type":"text","text":" "},{"type":"text","text":"settings and container or streaming protocol used by an application."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/haishinkit\/codec-support"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://HaishinKit/documentation/HaishinKit/macOS-debug-app":{"kind":"article","identifier":"doc:\/\/HaishinKit\/documentation\/HaishinKit\/macOS-debug-app","role":"article","abstract":[{"text":"Exercise capture, encoding, transport, and playback in the macOS Example app.","type":"text"}],"title":"macOS debug application","type":"topic","url":"\/documentation\/haishinkit\/macos-debug-app"},"https://developer.apple.com/documentation/audiotoolbox/1577853-audio-format-property-identifier":{"url":"https:\/\/developer.apple.com\/documentation\/audiotoolbox\/1577853-audio-format-property-identifier","titleInlineContent":[{"type":"text","text":"audio format property reference"}],"title":"audio format property reference","type":"link","identifier":"https:\/\/developer.apple.com\/documentation\/audiotoolbox\/1577853-audio-format-property-identifier"},"https://developer.apple.com/documentation/avfaudio/avaudioconverter":{"url":"https:\/\/developer.apple.com\/documentation\/avfaudio\/avaudioconverter","titleInlineContent":[{"type":"text","text":"AVAudioConverter"}],"title":"AVAudioConverter","type":"link","identifier":"https:\/\/developer.apple.com\/documentation\/avfaudio\/avaudioconverter"},"https://developer.apple.com/documentation/videotoolbox/vtishardwaredecodesupported(_:)":{"url":"https:\/\/developer.apple.com\/documentation\/videotoolbox\/vtishardwaredecodesupported(_:)","titleInlineContent":[{"text":"VTIsHardwareDecodeSupported","type":"text"}],"title":"VTIsHardwareDecodeSupported","type":"link","identifier":"https:\/\/developer.apple.com\/documentation\/videotoolbox\/vtishardwaredecodesupported(_:)"},"doc://HaishinKit/documentation/HaishinKit/visionos-studio":{"identifier":"doc:\/\/HaishinKit\/documentation\/HaishinKit\/visionos-studio","role":"article","title":"Using the visionOS sample studio","type":"topic","kind":"article","url":"\/documentation\/haishinkit\/visionos-studio","abstract":[{"text":"Receive streams or send a generated test signal from the ","type":"text"},{"type":"strong","inlineContent":[{"text":"Example visionOS","type":"text"}]},{"text":" scheme","type":"text"},{"type":"text","text":" "},{"type":"text","text":"in "},{"code":"Examples\/Examples.xcworkspace","type":"codeVoice"},{"text":".","type":"text"}]},"doc://HaishinKit/documentation/HaishinKit":{"identifier":"doc:\/\/HaishinKit\/documentation\/HaishinKit","abstract":[{"type":"text","text":"This is the main module."}],"type":"topic","role":"collection","url":"\/documentation\/haishinkit","kind":"symbol","images":[{"identifier":"haishinkit-app-icon.png","type":"icon"},{"identifier":"haishinkit-card.svg","type":"card"}],"title":"HaishinKit"},"https://developer.apple.com/documentation/videotoolbox/vtcopyvideoencoderlist(_:_:)":{"type":"link","identifier":"https:\/\/developer.apple.com\/documentation\/videotoolbox\/vtcopyvideoencoderlist(_:_:)","title":"VTCopyVideoEncoderList","titleInlineContent":[{"text":"VTCopyVideoEncoderList","type":"text"}],"url":"https:\/\/developer.apple.com\/documentation\/videotoolbox\/vtcopyvideoencoderlist(_:_:)"},"haishinkit-app-icon.png":{"type":"image","identifier":"haishinkit-app-icon.png","alt":"HaishinKit app icon","variants":[{"url":"\/images\/HaishinKit\/haishinkit-app-icon.png","traits":["1x","light"]}]},"haishinkit-card.svg":{"type":"image","identifier":"haishinkit-card.svg","alt":"HaishinKit app icon","variants":[{"url":"\/images\/HaishinKit\/haishinkit-card.svg","traits":["1x","light"]}]}}}