{"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"This optional product exposes ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AOMHaishinKit\/documentation\/AOMHaishinKit\/AOMVideoEncoder","type":"reference"},{"text":", ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AOMHaishinKit\/documentation\/AOMHaishinKit\/AOMVideoDecoder","type":"reference"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AOMHaishinKit\/documentation\/AOMHaishinKit\/AOMVideoCodecSettings","type":"reference"},{"text":" without depending on the ","type":"text"},{"code":"HaishinKit","type":"codeVoice"},{"text":" target. Applications","type":"text"},{"text":" ","type":"text"},{"text":"such as VQMetrix can call it directly. The existing ","type":"text"},{"code":"VideoCodec","type":"codeVoice"},{"text":", codec registration,","type":"text"},{"text":" ","type":"text"},{"text":"MediaMixer, and RTC\/RTMP\/SRT pipelines are unchanged; importing this product does not","type":"text"},{"text":" ","type":"text"},{"text":"add AV1 transport support.","type":"text"}]},{"text":"Installation","type":"heading","level":2,"anchor":"Installation"},{"type":"paragraph","inlineContent":[{"text":"This product is available on main, but is not included in the released 2.3.0 package:","type":"text"}]},{"type":"codeListing","code":[".package(url: \"https:\/\/github.com\/HaishinKit\/HaishinKit.swift.git\",","         branch: \"main\")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Add ","type":"text"},{"code":".product(name: \"AOMHaishinKit\", package: \"HaishinKit.swift\")","type":"codeVoice"},{"text":" to your target.","type":"text"},{"text":" ","type":"text"},{"text":"After publication, replace the main branch with a release containing this product.","type":"text"}]},{"text":"Standalone conversion","type":"heading","level":2,"anchor":"Standalone-conversion"},{"type":"paragraph","inlineContent":[{"text":"The following function needs no ","type":"text"},{"code":"import HaishinKit","type":"codeVoice"},{"text":" or shared codec registration:","type":"text"}]},{"syntax":"swift","code":["import CoreMedia","import AOMHaishinKit","","func roundTrip(_ references: [CMSampleBuffer]) throws -> [CMSampleBuffer] {","    let settings = AOMVideoCodecSettings(bitRate: 1_000_000)","    let encoder = try AOMVideoEncoder(settings: settings)","    let decoder = try AOMVideoDecoder()","    defer { encoder.invalidate(); decoder.invalidate() }","    var restored: [CMSampleBuffer] = []","    for reference in references {","        for packet in try encoder.encode(reference) {","            restored += try decoder.decode(packet)","        }","    }","    for packet in try encoder.finish() {","        restored += try decoder.decode(packet)","    }","    return restored","}"],"type":"codeListing"},{"inlineContent":[{"code":"encode","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"decode","type":"codeVoice"},{"text":" synchronously return owned Core Media samples. Copying encoded","type":"text"},{"text":" ","type":"text"},{"text":"bytes and decoded pixels before libaom reuses its buffers makes retained outputs safe.","type":"text"},{"text":" ","type":"text"},{"text":"The classes are deliberately non-Sendable: create and use each instance on one actor","type":"text"},{"text":" ","type":"text"},{"text":"or serial executor. Software compression runs on that caller; use a worker executor","type":"text"},{"text":" ","type":"text"},{"text":"for UI applications. The APIs throw errors directly rather than dropping outputs","type":"text"},{"text":" ","type":"text"},{"text":"through an asynchronous continuation.","type":"text"}],"type":"paragraph"},{"anchor":"Settings-and-lifecycle","text":"Settings and lifecycle","type":"heading","level":2},{"inlineContent":[{"text":"AV1 uses 8-bit SDR 4:2:0. The encoder accepts only video-range planar","type":"text"},{"text":" ","type":"text"},{"text":"I420 (","type":"text"},{"code":"kCVPixelFormatType_420YpCbCr8Planar","type":"codeVoice"},{"text":"), with dimensions exactly matching","type":"text"},{"text":" ","type":"text"},{"code":"videoSize","type":"codeVoice"},{"text":". It passes the three planes and their row strides directly to libaom","type":"text"},{"text":" ","type":"text"},{"text":"while the input pixel buffer is locked. The caller is responsible for color-space","type":"text"},{"text":" ","type":"text"},{"text":"conversion, range normalization, and resizing before encoding. NV12, RGB, full-range,","type":"text"},{"text":" ","type":"text"},{"text":"10-bit, and mismatched dimensions are rejected rather than converted implicitly.","type":"text"},{"text":" ","type":"text"},{"text":"Encoded width\/height must be positive even integers, within the codec limit, and","type":"text"},{"text":" ","type":"text"},{"text":"their product must not exceed 16,777,216 pixels. AV1 high-bit-depth and 4:4:4 are not supported.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"PTS values must be numeric, epoch zero, and strictly increasing after conversion","type":"text"},{"text":" ","type":"text"},{"text":"to a microsecond timebase. Numeric positive input durations are preserved to that","type":"text"},{"text":" ","type":"text"},{"text":"precision; otherwise the frame-rate hint provides a duration. The hint must be finite","type":"text"},{"text":" ","type":"text"},{"text":"and between 0.001 and 1,000,000 fps. Keyframe intervals are timestamp-based, between","type":"text"},{"text":" ","type":"text"},{"text":"one microsecond and one hour, so skipped inputs do not extend the keyframe interval.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Compression uses libaom realtime usage with CPU-used 8, two worker threads,","type":"text"},{"text":" ","type":"text"},{"text":"and zero-lookahead operation with no intentional frame drops","type":"text"},{"text":" ","type":"text"},{"text":"or frame reordering. Average and constant bitrate modes are available. Call ","type":"text"},{"code":"update","type":"codeVoice"},{"text":" ","type":"text"},{"text":"to change bitrate and frame-rate hints. Changing dimensions,","type":"text"},{"text":" ","type":"text"},{"text":"bitrate mode, or keyframe interval requires a new encoder and is rejected by ","type":"text"},{"code":"update","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"code":"finish","type":"codeVoice"},{"text":" drains the encoder and rejects further input; repeated calls return no","type":"text"},{"text":" ","type":"text"},{"text":"packets. ","type":"text"},{"code":"invalidate","type":"codeVoice"},{"text":" releases resources and is safe to call repeatedly. Construct","type":"text"},{"text":" ","type":"text"},{"text":"new encoder\/decoder instances to restart.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The decoder consumes raw compressed AV1 samples with a matching format description,","type":"text"},{"text":" ","type":"text"},{"text":"and returns NV12 frames with the packet PTS\/duration and decoded full\/video range.","type":"text"},{"text":" ","type":"text"},{"text":"The caller must demultiplex a container and supply packet timing; this module does not","type":"text"},{"text":" ","type":"text"},{"text":"read\/write MP4, IVF, or WebM files, nor add RTP\/Enhanced RTMP\/TS framing.","type":"text"},{"text":" ","type":"text"},{"text":"Only decoded pixel range is signaled here; interpreting and attaching container colorimetry remains the caller’s responsibility.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Encoding and decoding follow the package’s existing platform minimums; this module","type":"text"},{"text":" ","type":"text"},{"text":"does not depend on VideoToolbox pixel transfer. The libaom 3.15.3 artifact supports arm64, including Apple silicon","type":"text"},{"text":" ","type":"text"},{"text":"simulators; it does not include Intel slices. Preserve the libaom LICENSE and PATENTS","type":"text"},{"text":" ","type":"text"},{"text":"notices from libaom-xcframework when distributing an app.","type":"text"}],"type":"paragraph"},{"anchor":"Encoder-statistics","text":"Encoder statistics","type":"heading","level":2},{"inlineContent":[{"text":"Read ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AOMHaishinKit\/documentation\/AOMHaishinKit\/AOMVideoEncoder\/statistics","type":"reference"},{"text":" on the encoder’s actor or serial executor,","type":"text"},{"text":" ","type":"text"},{"text":"then send the value snapshot to VQMetrix’s UI, history store, or report:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let snapshot = encoder.statistics","print(snapshot.submittedFrameCount, snapshot.outputPacketCount, snapshot.encodedByteCount)","print(snapshot.lastEncodingDuration, snapshot.averageEncodingDuration,","      snapshot.maximumEncodingDuration, snapshot.totalEncodingDuration)"],"type":"codeListing"},{"inlineContent":[{"text":"Durations are monotonic wall-clock seconds inside successful native frame-encode calls,","type":"text"},{"text":" ","type":"text"},{"text":"including scheduling delays. They exclude caller conversion, input validation, output","type":"text"},{"text":" ","type":"text"},{"text":"copying, failed encode calls, and ","type":"text"},{"code":"finish()","type":"codeVoice"},{"text":" flushing. They are not CPU utilization,","type":"text"},{"text":" ","type":"text"},{"text":"thermal state, energy use, or end-to-end latency. Packet\/byte counters include drained","type":"text"},{"text":" ","type":"text"},{"text":"output. Counters live for the encoder’s lifetime, survive invalidation, and are not","type":"text"},{"text":" ","type":"text"},{"text":"reset by settings updates. Snapshots are Codable and Sendable.","type":"text"}],"type":"paragraph"},{"anchor":"Verification","text":"Verification","type":"heading","level":2},{"inlineContent":[{"text":"Run ","type":"text"},{"code":"swift test --filter AOMVideoCodecTests","type":"codeVoice"},{"text":" for AV1 round trips, owned outputs,","type":"text"},{"text":" ","type":"text"},{"text":"keyframe timing, settings updates, unsupported input\/dimension rejection, malformed packets, and lifecycle checks.","type":"text"},{"text":" ","type":"text"},{"code":"swift run --package-path AOMHaishinKit\/Tests\/Consumer Consumer","type":"codeVoice"},{"text":" exercises a separate","type":"text"},{"text":" ","type":"text"},{"text":"SwiftPM consumer importing only the public AOM API, without linking the HaishinKit core.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The published libaom 3.15.3 artifact includes embedded DWARF debug information in its static libraries. Retain the final app archive and matching app dSYM for symbolication.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"text":"Standalone software AV1 encoding and decoding.","type":"text"}],"metadata":{"title":"AOMHaishinKit","symbolKind":"module","images":[{"identifier":"aomhaishinkit-icon.png","type":"icon"},{"identifier":"aomhaishinkit-card.png","type":"card"}],"role":"collection","externalID":"AOMHaishinKit","modules":[{"name":"AOMHaishinKit"}],"roleHeading":"Framework"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/aomhaishinkit"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AOMHaishinKit\/documentation\/AOMHaishinKit"},"kind":"symbol","hierarchy":{"paths":[[]]},"topicSections":[{"identifiers":["doc:\/\/AOMHaishinKit\/documentation\/AOMHaishinKit\/AOMVideoEncoder","doc:\/\/AOMHaishinKit\/documentation\/AOMHaishinKit\/AOMVideoDecoder"],"title":"Encoding and decoding","anchor":"Encoding-and-decoding"},{"identifiers":["doc:\/\/AOMHaishinKit\/documentation\/AOMHaishinKit\/AOMVideoCodecSettings","doc:\/\/AOMHaishinKit\/documentation\/AOMHaishinKit\/AOMVideoCodecSettings\/BitRateMode-swift.enum","doc:\/\/AOMHaishinKit\/documentation\/AOMHaishinKit\/AOMVideoCodecError"],"title":"Configuration and failures","anchor":"Configuration-and-failures"},{"identifiers":["doc:\/\/AOMHaishinKit\/documentation\/AOMHaishinKit\/AOMVideoEncoderStatistics"],"title":"Measurement","anchor":"Measurement"}],"references":{"doc://AOMHaishinKit/documentation/AOMHaishinKit":{"title":"AOMHaishinKit","kind":"symbol","identifier":"doc:\/\/AOMHaishinKit\/documentation\/AOMHaishinKit","images":[{"identifier":"aomhaishinkit-icon.png","type":"icon"},{"identifier":"aomhaishinkit-card.png","type":"card"}],"type":"topic","abstract":[{"text":"Standalone software AV1 encoding and decoding.","type":"text"}],"url":"\/documentation\/aomhaishinkit","role":"collection"},"aomhaishinkit-card.png":{"variants":[{"url":"\/images\/AOMHaishinKit\/aomhaishinkit-card.png","traits":["1x","light"]}],"alt":"AV1 video frame divided into coding blocks","identifier":"aomhaishinkit-card.png","type":"image"},"doc://AOMHaishinKit/documentation/AOMHaishinKit/AOMVideoDecoder":{"title":"AOMVideoDecoder","navigatorTitle":[{"kind":"identifier","text":"AOMVideoDecoder"}],"kind":"symbol","identifier":"doc:\/\/AOMHaishinKit\/documentation\/AOMHaishinKit\/AOMVideoDecoder","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"AOMVideoDecoder"}],"type":"topic","abstract":[{"text":"A synchronous decoder. Returned frames own their pixel storage; calls must be serialized.","type":"text"}],"url":"\/documentation\/aomhaishinkit\/aomvideodecoder","role":"symbol"},"doc://AOMHaishinKit/documentation/AOMHaishinKit/AOMVideoCodecSettings/BitRateMode-swift.enum":{"type":"topic","url":"\/documentation\/aomhaishinkit\/aomvideocodecsettings\/bitratemode-swift.enum","title":"AOMVideoCodecSettings.BitRateMode","kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"BitRateMode"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"BitRateMode"}],"identifier":"doc:\/\/AOMHaishinKit\/documentation\/AOMHaishinKit\/AOMVideoCodecSettings\/BitRateMode-swift.enum","abstract":[{"text":"The libaom rate-control strategy. Neither mode guarantees an exact bitrate.","type":"text"}]},"aomhaishinkit-icon.png":{"variants":[{"url":"\/images\/AOMHaishinKit\/aomhaishinkit-icon.png","traits":["1x","light"]}],"alt":"AV1 video frame divided into coding blocks","identifier":"aomhaishinkit-icon.png","type":"image"},"doc://AOMHaishinKit/documentation/AOMHaishinKit/AOMVideoEncoderStatistics":{"abstract":[{"text":"A value snapshot of one encoder’s lifetime counters, suitable for reports and cross-actor transfer.","type":"text"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"AOMVideoEncoderStatistics"}],"url":"\/documentation\/aomhaishinkit\/aomvideoencoderstatistics","identifier":"doc:\/\/AOMHaishinKit\/documentation\/AOMHaishinKit\/AOMVideoEncoderStatistics","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AOMVideoEncoderStatistics"}],"title":"AOMVideoEncoderStatistics"},"doc://AOMHaishinKit/documentation/AOMHaishinKit/AOMVideoEncoder/statistics":{"type":"topic","abstract":[{"text":"Current lifetime statistics. Read on the same actor or serial executor as encode calls.","type":"text"},{"text":" ","type":"text"},{"text":"Copy this Sendable value to forward a snapshot to a UI, history store, or report.","type":"text"}],"url":"\/documentation\/aomhaishinkit\/aomvideoencoder\/statistics","identifier":"doc:\/\/AOMHaishinKit\/documentation\/AOMHaishinKit\/AOMVideoEncoder\/statistics","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"statistics"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"AOMVideoEncoderStatistics","preciseIdentifier":"s:13AOMHaishinKit25AOMVideoEncoderStatisticsV"}],"title":"statistics"},"doc://AOMHaishinKit/documentation/AOMHaishinKit/AOMVideoCodecError":{"title":"AOMVideoCodecError","navigatorTitle":[{"kind":"identifier","text":"AOMVideoCodecError"}],"kind":"symbol","identifier":"doc:\/\/AOMHaishinKit\/documentation\/AOMHaishinKit\/AOMVideoCodecError","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"AOMVideoCodecError"}],"type":"topic","abstract":[{"text":"A standalone codec failure. Unsupported configurations never select another codec.","type":"text"}],"url":"\/documentation\/aomhaishinkit\/aomvideocodecerror","role":"symbol"},"doc://AOMHaishinKit/documentation/AOMHaishinKit/AOMVideoCodecSettings":{"title":"AOMVideoCodecSettings","navigatorTitle":[{"kind":"identifier","text":"AOMVideoCodecSettings"}],"kind":"symbol","identifier":"doc:\/\/AOMHaishinKit\/documentation\/AOMHaishinKit\/AOMVideoCodecSettings","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AOMVideoCodecSettings"}],"type":"topic","abstract":[{"text":"Settings for standalone, 8-bit software AV1 compression.","type":"text"}],"url":"\/documentation\/aomhaishinkit\/aomvideocodecsettings","role":"symbol"},"doc://AOMHaishinKit/documentation/AOMHaishinKit/AOMVideoEncoder":{"title":"AOMVideoEncoder","navigatorTitle":[{"kind":"identifier","text":"AOMVideoEncoder"}],"kind":"symbol","identifier":"doc:\/\/AOMHaishinKit\/documentation\/AOMHaishinKit\/AOMVideoEncoder","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"AOMVideoEncoder"}],"type":"topic","abstract":[{"text":"A synchronous encoder. Confine the instance and its calls to one actor or serial executor.","type":"text"}],"url":"\/documentation\/aomhaishinkit\/aomvideoencoder","role":"symbol"}}}