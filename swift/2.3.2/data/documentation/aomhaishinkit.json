{"abstract":[{"text":"Standalone software AV1 encoding and decoding.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/aomhaishinkit"]}],"identifier":{"url":"doc:\/\/AOMHaishinKit\/documentation\/AOMHaishinKit","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This optional product exposes "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AOMHaishinKit\/documentation\/AOMHaishinKit\/AOMVideoEncoder"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AOMHaishinKit\/documentation\/AOMHaishinKit\/AOMVideoDecoder"},{"type":"text","text":", and"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AOMHaishinKit\/documentation\/AOMHaishinKit\/AOMVideoCodecSettings"},{"type":"text","text":" without depending on the "},{"type":"codeVoice","code":"HaishinKit"},{"type":"text","text":" target. Applications"},{"type":"text","text":" "},{"type":"text","text":"such as VQMetrix can call it directly. The existing "},{"type":"codeVoice","code":"VideoCodec"},{"type":"text","text":", codec registration,"},{"type":"text","text":" "},{"type":"text","text":"MediaMixer, and RTC\/RTMP\/SRT pipelines are unchanged; importing this product does not"},{"type":"text","text":" "},{"type":"text","text":"add AV1 transport support."}]},{"level":2,"text":"Installation","type":"heading","anchor":"Installation"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This product is available on main, but is not included in the released 2.3.0 package:"}]},{"type":"codeListing","syntax":"swift","code":[".package(url: \"https:\/\/github.com\/HaishinKit\/HaishinKit.swift.git\",","         branch: \"main\")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add "},{"type":"codeVoice","code":".product(name: \"AOMHaishinKit\", package: \"HaishinKit.swift\")"},{"type":"text","text":" to your target."},{"type":"text","text":" "},{"type":"text","text":"After publication, replace the main branch with a release containing this product."}]},{"level":2,"text":"Standalone conversion","type":"heading","anchor":"Standalone-conversion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following function needs no "},{"type":"codeVoice","code":"import HaishinKit"},{"type":"text","text":" or shared codec registration:"}]},{"type":"codeListing","syntax":"swift","code":["import CoreMedia","import AOMHaishinKit","","func roundTrip(_ references: [CMSampleBuffer]) throws -> [CMSampleBuffer] {","    let settings = AOMVideoCodecSettings(bitRate: 1_000_000)","    let encoder = try AOMVideoEncoder(settings: settings)","    let decoder = try AOMVideoDecoder()","    defer { encoder.invalidate(); decoder.invalidate() }","    var restored: [CMSampleBuffer] = []","    for reference in references {","        for packet in try encoder.encode(reference) {","            restored += try decoder.decode(packet)","        }","    }","    for packet in try encoder.finish() {","        restored += try decoder.decode(packet)","    }","    return restored","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"encode"},{"type":"text","text":" and "},{"type":"codeVoice","code":"decode"},{"type":"text","text":" synchronously return owned Core Media samples. Copying encoded"},{"type":"text","text":" "},{"type":"text","text":"bytes and decoded pixels before libaom reuses its buffers makes retained outputs safe."},{"type":"text","text":" "},{"type":"text","text":"The classes are deliberately non-Sendable: create and use each instance on one actor"},{"type":"text","text":" "},{"type":"text","text":"or serial executor. Software compression runs on that caller; use a worker executor"},{"type":"text","text":" "},{"type":"text","text":"for UI applications. The APIs throw errors directly rather than dropping outputs"},{"type":"text","text":" "},{"type":"text","text":"through an asynchronous continuation."}]},{"level":2,"text":"Settings and lifecycle","type":"heading","anchor":"Settings-and-lifecycle"},{"type":"paragraph","inlineContent":[{"type":"text","text":"AV1 uses 8-bit SDR 4:2:0. The encoder accepts only video-range planar"},{"type":"text","text":" "},{"type":"text","text":"I420 ("},{"type":"codeVoice","code":"kCVPixelFormatType_420YpCbCr8Planar"},{"type":"text","text":"), with dimensions exactly matching"},{"type":"text","text":" "},{"type":"codeVoice","code":"videoSize"},{"type":"text","text":". It passes the three planes and their row strides directly to libaom"},{"type":"text","text":" "},{"type":"text","text":"while the input pixel buffer is locked. The caller is responsible for color-space"},{"type":"text","text":" "},{"type":"text","text":"conversion, range normalization, and resizing before encoding. NV12, RGB, full-range,"},{"type":"text","text":" "},{"type":"text","text":"10-bit, and mismatched dimensions are rejected rather than converted implicitly."},{"type":"text","text":" "},{"type":"text","text":"Encoded width\/height must be positive even integers, within the codec limit, and"},{"type":"text","text":" "},{"type":"text","text":"their product must not exceed 16,777,216 pixels. AV1 high-bit-depth and 4:4:4 are not supported."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"PTS values must be numeric, epoch zero, and strictly increasing after conversion"},{"type":"text","text":" "},{"type":"text","text":"to a microsecond timebase. Numeric positive input durations are preserved to that"},{"type":"text","text":" "},{"type":"text","text":"precision; otherwise the frame-rate hint provides a duration. The hint must be finite"},{"type":"text","text":" "},{"type":"text","text":"and between 0.001 and 1,000,000 fps. Keyframe intervals are timestamp-based, between"},{"type":"text","text":" "},{"type":"text","text":"one microsecond and one hour, so skipped inputs do not extend the keyframe interval."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Compression uses libaom realtime usage with CPU-used 8, two worker threads,"},{"type":"text","text":" "},{"type":"text","text":"and zero-lookahead operation with no intentional frame drops"},{"type":"text","text":" "},{"type":"text","text":"or frame reordering. Average and constant bitrate modes are available. Call "},{"type":"codeVoice","code":"update"},{"type":"text","text":" "},{"type":"text","text":"to change bitrate and frame-rate hints. Changing dimensions,"},{"type":"text","text":" "},{"type":"text","text":"bitrate mode, or keyframe interval requires a new encoder and is rejected by "},{"type":"codeVoice","code":"update"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"codeVoice","code":"finish"},{"type":"text","text":" drains the encoder and rejects further input; repeated calls return no"},{"type":"text","text":" "},{"type":"text","text":"packets. "},{"type":"codeVoice","code":"invalidate"},{"type":"text","text":" releases resources and is safe to call repeatedly. Construct"},{"type":"text","text":" "},{"type":"text","text":"new encoder\/decoder instances to restart."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The decoder consumes raw compressed AV1 samples with a matching format description,"},{"type":"text","text":" "},{"type":"text","text":"and returns NV12 frames with the packet PTS\/duration and decoded full\/video range."},{"type":"text","text":" "},{"type":"text","text":"The caller must demultiplex a container and supply packet timing; this module does not"},{"type":"text","text":" "},{"type":"text","text":"read\/write MP4, IVF, or WebM files, nor add RTP\/Enhanced RTMP\/TS framing."},{"type":"text","text":" "},{"type":"text","text":"Only decoded pixel range is signaled here; interpreting and attaching container colorimetry remains the caller’s responsibility."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Encoding and decoding follow the package’s existing platform minimums; this module"},{"type":"text","text":" "},{"type":"text","text":"does not depend on VideoToolbox pixel transfer. The libaom 3.15.3 artifact supports arm64, including Apple silicon"},{"type":"text","text":" "},{"type":"text","text":"simulators; it does not include Intel slices. Preserve the libaom LICENSE and PATENTS"},{"type":"text","text":" "},{"type":"text","text":"notices from libaom-xcframework when distributing an app."}]},{"level":2,"text":"Encoder statistics","type":"heading","anchor":"Encoder-statistics"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Read "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AOMHaishinKit\/documentation\/AOMHaishinKit\/AOMVideoEncoder\/statistics"},{"type":"text","text":" on the encoder’s actor or serial executor,"},{"type":"text","text":" "},{"type":"text","text":"then send the value snapshot to VQMetrix’s UI, history store, or report:"}]},{"type":"codeListing","syntax":"swift","code":["let snapshot = encoder.statistics","print(snapshot.submittedFrameCount, snapshot.outputPacketCount, snapshot.encodedByteCount)","print(snapshot.lastEncodingDuration, snapshot.averageEncodingDuration,","      snapshot.maximumEncodingDuration, snapshot.totalEncodingDuration)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Durations are monotonic wall-clock seconds inside successful native frame-encode calls,"},{"type":"text","text":" "},{"type":"text","text":"including scheduling delays. They exclude caller conversion, input validation, output"},{"type":"text","text":" "},{"type":"text","text":"copying, failed encode calls, and "},{"type":"codeVoice","code":"finish()"},{"type":"text","text":" flushing. They are not CPU utilization,"},{"type":"text","text":" "},{"type":"text","text":"thermal state, energy use, or end-to-end latency. Packet\/byte counters include drained"},{"type":"text","text":" "},{"type":"text","text":"output. Counters live for the encoder’s lifetime, survive invalidation, and are not"},{"type":"text","text":" "},{"type":"text","text":"reset by settings updates. Snapshots are Codable and Sendable."}]},{"level":2,"text":"Verification","type":"heading","anchor":"Verification"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Run "},{"type":"codeVoice","code":"swift test --filter AOMVideoCodecTests"},{"type":"text","text":" for AV1 round trips, owned outputs,"},{"type":"text","text":" "},{"type":"text","text":"keyframe timing, settings updates, unsupported input\/dimension rejection, malformed packets, and lifecycle checks."},{"type":"text","text":" "},{"type":"codeVoice","code":"swift run --package-path AOMHaishinKit\/Tests\/Consumer Consumer"},{"type":"text","text":" exercises a separate"},{"type":"text","text":" "},{"type":"text","text":"SwiftPM consumer importing only the public AOM API, without linking the HaishinKit core."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The published libaom 3.15.3 artifact includes embedded DWARF debug information in its static libraries. Retain the final app archive and matching app dSYM for symbolication."}]}]}],"kind":"symbol","sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[[]]},"metadata":{"title":"AOMHaishinKit","symbolKind":"module","modules":[{"name":"AOMHaishinKit"}],"externalID":"AOMHaishinKit","roleHeading":"Framework","images":[{"type":"icon","identifier":"aomhaishinkit-icon.png"},{"type":"card","identifier":"aomhaishinkit-card.png"}],"role":"collection"},"topicSections":[{"title":"Encoding and decoding","identifiers":["doc:\/\/AOMHaishinKit\/documentation\/AOMHaishinKit\/AOMVideoEncoder","doc:\/\/AOMHaishinKit\/documentation\/AOMHaishinKit\/AOMVideoDecoder"],"anchor":"Encoding-and-decoding"},{"title":"Configuration and failures","identifiers":["doc:\/\/AOMHaishinKit\/documentation\/AOMHaishinKit\/AOMVideoCodecSettings","doc:\/\/AOMHaishinKit\/documentation\/AOMHaishinKit\/AOMVideoCodecSettings\/BitRateMode-swift.enum","doc:\/\/AOMHaishinKit\/documentation\/AOMHaishinKit\/AOMVideoCodecError"],"anchor":"Configuration-and-failures"},{"title":"Measurement","identifiers":["doc:\/\/AOMHaishinKit\/documentation\/AOMHaishinKit\/AOMVideoEncoderStatistics"],"anchor":"Measurement"}],"references":{"doc://AOMHaishinKit/documentation/AOMHaishinKit/AOMVideoEncoderStatistics":{"abstract":[{"type":"text","text":"A value snapshot of one encoder’s lifetime counters, suitable for reports and cross-actor transfer."}],"title":"AOMVideoEncoderStatistics","identifier":"doc:\/\/AOMHaishinKit\/documentation\/AOMHaishinKit\/AOMVideoEncoderStatistics","navigatorTitle":[{"kind":"identifier","text":"AOMVideoEncoderStatistics"}],"type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AOMVideoEncoderStatistics"}],"url":"\/documentation\/aomhaishinkit\/aomvideoencoderstatistics","role":"symbol"},"doc://AOMHaishinKit/documentation/AOMHaishinKit/AOMVideoDecoder":{"abstract":[{"text":"A synchronous decoder. Returned frames own their pixel storage; calls must be serialized.","type":"text"}],"title":"AOMVideoDecoder","identifier":"doc:\/\/AOMHaishinKit\/documentation\/AOMHaishinKit\/AOMVideoDecoder","navigatorTitle":[{"kind":"identifier","text":"AOMVideoDecoder"}],"type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"AOMVideoDecoder"}],"url":"\/documentation\/aomhaishinkit\/aomvideodecoder","role":"symbol"},"doc://AOMHaishinKit/documentation/AOMHaishinKit":{"role":"collection","title":"AOMHaishinKit","images":[{"type":"icon","identifier":"aomhaishinkit-icon.png"},{"type":"card","identifier":"aomhaishinkit-card.png"}],"type":"topic","url":"\/documentation\/aomhaishinkit","kind":"symbol","identifier":"doc:\/\/AOMHaishinKit\/documentation\/AOMHaishinKit","abstract":[{"type":"text","text":"Standalone software AV1 encoding and decoding."}]},"doc://AOMHaishinKit/documentation/AOMHaishinKit/AOMVideoCodecError":{"role":"symbol","title":"AOMVideoCodecError","type":"topic","url":"\/documentation\/aomhaishinkit\/aomvideocodecerror","kind":"symbol","identifier":"doc:\/\/AOMHaishinKit\/documentation\/AOMHaishinKit\/AOMVideoCodecError","abstract":[{"type":"text","text":"A standalone codec failure. Unsupported configurations never select another codec."}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"AOMVideoCodecError"}],"navigatorTitle":[{"kind":"identifier","text":"AOMVideoCodecError"}]},"doc://AOMHaishinKit/documentation/AOMHaishinKit/AOMVideoEncoder/statistics":{"abstract":[{"text":"Current lifetime statistics. Read on the same actor or serial executor as encode calls.","type":"text"},{"text":" ","type":"text"},{"text":"Copy this Sendable value to forward a snapshot to a UI, history store, or report.","type":"text"}],"title":"statistics","identifier":"doc:\/\/AOMHaishinKit\/documentation\/AOMHaishinKit\/AOMVideoEncoder\/statistics","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"statistics"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"AOMVideoEncoderStatistics","preciseIdentifier":"s:13AOMHaishinKit25AOMVideoEncoderStatisticsV"}],"url":"\/documentation\/aomhaishinkit\/aomvideoencoder\/statistics","role":"symbol"},"doc://AOMHaishinKit/documentation/AOMHaishinKit/AOMVideoCodecSettings/BitRateMode-swift.enum":{"abstract":[{"text":"The libaom rate-control strategy. Neither mode guarantees an exact bitrate.","type":"text"}],"title":"AOMVideoCodecSettings.BitRateMode","identifier":"doc:\/\/AOMHaishinKit\/documentation\/AOMHaishinKit\/AOMVideoCodecSettings\/BitRateMode-swift.enum","navigatorTitle":[{"text":"BitRateMode","kind":"identifier"}],"type":"topic","kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BitRateMode","kind":"identifier"}],"url":"\/documentation\/aomhaishinkit\/aomvideocodecsettings\/bitratemode-swift.enum","role":"symbol"},"doc://AOMHaishinKit/documentation/AOMHaishinKit/AOMVideoCodecSettings":{"role":"symbol","title":"AOMVideoCodecSettings","type":"topic","url":"\/documentation\/aomhaishinkit\/aomvideocodecsettings","kind":"symbol","identifier":"doc:\/\/AOMHaishinKit\/documentation\/AOMHaishinKit\/AOMVideoCodecSettings","abstract":[{"text":"Settings for standalone, 8-bit software AV1 compression.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AOMVideoCodecSettings"}],"navigatorTitle":[{"kind":"identifier","text":"AOMVideoCodecSettings"}]},"aomhaishinkit-icon.png":{"identifier":"aomhaishinkit-icon.png","alt":"AV1 video frame divided into coding blocks","type":"image","variants":[{"url":"\/images\/AOMHaishinKit\/aomhaishinkit-icon.png","traits":["1x","light"]}]},"doc://AOMHaishinKit/documentation/AOMHaishinKit/AOMVideoEncoder":{"abstract":[{"type":"text","text":"A synchronous encoder. Confine the instance and its calls to one actor or serial executor."}],"title":"AOMVideoEncoder","identifier":"doc:\/\/AOMHaishinKit\/documentation\/AOMHaishinKit\/AOMVideoEncoder","navigatorTitle":[{"text":"AOMVideoEncoder","kind":"identifier"}],"type":"topic","kind":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AOMVideoEncoder","kind":"identifier"}],"url":"\/documentation\/aomhaishinkit\/aomvideoencoder","role":"symbol"},"aomhaishinkit-card.png":{"identifier":"aomhaishinkit-card.png","alt":"AV1 video frame divided into coding blocks","type":"image","variants":[{"url":"\/images\/AOMHaishinKit\/aomhaishinkit-card.png","traits":["1x","light"]}]}}}