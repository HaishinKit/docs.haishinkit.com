{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/haishinkit\/scene-files"]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/HaishinKit\/documentation\/HaishinKit"]]},"identifier":{"url":"doc:\/\/HaishinKit\/documentation\/HaishinKit\/scene-files","interfaceLanguage":"swift"},"metadata":{"modules":[{"name":"HaishinKit"}],"roleHeading":"Article","role":"article","title":"Portable scene files"},"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"article","abstract":[{"text":"Save a ScreenObjectSnapshot and its media in one portable file.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"File-format","level":2,"text":"File format","type":"heading"},{"inlineContent":[{"text":"A ","type":"text"},{"code":".scene","type":"codeVoice"},{"text":" file is a regular ZIP containing:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"scene.json"},{"type":"text","text":": a camelCase "},{"type":"reference","isActive":true,"identifier":"doc:\/\/HaishinKit\/documentation\/HaishinKit\/ScreenObjectSnapshot"},{"type":"text","text":" object, without an envelope."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"manifest.json"},{"type":"text","text":": "},{"type":"codeVoice","code":"{\"format\":\"haishinkit.scene\",\"version\":1}"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"media\/<filename>"},{"text":": bundled images, video, or resources for future object types.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Readers accept ZIP STORE and DEFLATE entries, including streamed ZIP data descriptors."},{"type":"text","text":" "},{"type":"text","text":"They also accept standalone snapshot JSON when no external media is needed."},{"type":"text","text":" "},{"type":"text","text":"Resource names are flat filenames, unique under the shared conservative case key"},{"type":"text","text":" "},{"type":"text","text":"(NFC, lowercase, uppercase, lowercase, NFC; Unicode default\/ROOT casing); absolute paths and traversal are rejected."},{"type":"text","text":" "},{"type":"text","text":"The limits are 128 MiB of resources, 256 resources, and 4 MiB of snapshot JSON."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The snapshot retains "},{"type":"codeVoice","code":"type"},{"type":"text","text":", "},{"type":"codeVoice","code":"id"},{"type":"text","text":", "},{"type":"codeVoice","code":"size"},{"type":"text","text":", "},{"type":"codeVoice","code":"isVisible"},{"type":"text","text":", "},{"type":"codeVoice","code":"layoutMargin"},{"type":"text","text":", horizontal"},{"type":"text","text":" "},{"type":"text","text":"and vertical alignment, "},{"type":"codeVoice","code":"elements"},{"type":"text","text":", "},{"type":"codeVoice","code":"children"},{"type":"text","text":", and optional "},{"type":"codeVoice","code":"cornerRadius"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Object-specific properties stay in the string-valued "},{"type":"codeVoice","code":"elements"},{"type":"text","text":" map. Images and"},{"type":"text","text":" "},{"type":"text","text":"assets reference bundled media with "},{"type":"codeVoice","code":"source: \"media\/<filename>\""},{"type":"text","text":". Inline image"},{"type":"text","text":" "},{"type":"text","text":"data URLs remain supported. Video gravity values are "},{"type":"codeVoice","code":"resize"},{"type":"text","text":", "},{"type":"codeVoice","code":"resizeAspect"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"resizeAspectFill"},{"type":"text","text":"; an omitted value means "},{"type":"codeVoice","code":"resizeAspect"},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Save-and-load","level":2,"text":"Save and load","type":"heading"},{"syntax":"swift","type":"codeListing","code":["let snapshot = ScreenObjectSnapshotFactory().make(screenObject)","let sceneFile = try SceneFile(snapshot: snapshot, resources: [\"overlay.png\": imageData])","try sceneFile.encoded().write(to: destination, options: .atomic)","let restored = try SceneFile(data: Data(contentsOf: destination))"]},{"type":"paragraph","inlineContent":[{"text":"Before saving, use relative media references, or supply resources named after the","type":"text"},{"text":" ","type":"text"},{"text":"local file URL’s last path component; the scene file converts matching image\/asset","type":"text"},{"text":" ","type":"text"},{"text":"file URLs to portable references. After loading, materialize resources in app","type":"text"},{"text":" ","type":"text"},{"text":"storage and replace known media references with those local file URLs before","type":"text"},{"text":" ","type":"text"},{"text":"passing the snapshot to ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/HaishinKit\/documentation\/HaishinKit\/ScreenObjectFactory"},{"text":". The scene file does not open","type":"text"},{"text":" ","type":"text"},{"text":"capture devices, request permissions, or restore transport credentials.","type":"text"}]},{"level":2,"anchor":"Unsupported-objects","type":"heading","text":"Unsupported objects"},{"type":"paragraph","inlineContent":[{"text":"An unsupported type produces an invisible placeholder. Snapshot capture returns","type":"text"},{"text":" ","type":"text"},{"text":"its original type, properties, visibility intent, and subtree so another platform","type":"text"},{"text":" ","type":"text"},{"text":"can restore it later. Do not discard opaque objects or their bundled resources","type":"text"},{"text":" ","type":"text"},{"text":"when editing or exporting. A saved ","type":"text"},{"code":"isVisible: true","type":"codeVoice"},{"text":" remains true even when the","type":"text"},{"text":" ","type":"text"},{"text":"current platform cannot