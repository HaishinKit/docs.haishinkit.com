{"variants":[{"paths":["\/documentation\/vpxhaishinkit"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"text":"Standalone software VP8 and VP9 encoding and decoding.","type":"text"}],"metadata":{"title":"VPXHaishinKit","roleHeading":"Framework","externalID":"VPXHaishinKit","symbolKind":"module","role":"collection","images":[{"identifier":"vpxhaishinkit-icon.png","type":"icon"},{"identifier":"vpxhaishinkit-card.png","type":"card"}],"modules":[{"name":"VPXHaishinKit"}]},"sections":[],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/VPXHaishinKit\/documentation\/VPXHaishinKit"},"primaryContentSections":[{"content":[{"text":"Overview","anchor":"overview","level":2,"type":"heading"},{"inlineContent":[{"text":"This optional product exposes ","type":"text"},{"identifier":"doc:\/\/VPXHaishinKit\/documentation\/VPXHaishinKit\/VPXVideoEncoder","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/VPXHaishinKit\/documentation\/VPXHaishinKit\/VPXVideoDecoder","isActive":true,"type":"reference"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/VPXHaishinKit\/documentation\/VPXHaishinKit\/VPXVideoCodecSettings","isActive":true,"type":"reference"},{"text":" without depending on the ","type":"text"},{"code":"HaishinKit","type":"codeVoice"},{"text":" target. Applications","type":"text"},{"text":" ","type":"text"},{"text":"such as VQMetrix can call it directly. The existing ","type":"text"},{"code":"VideoCodec","type":"codeVoice"},{"text":", codec registration,","type":"text"},{"text":" ","type":"text"},{"text":"MediaMixer, and RTC\/RTMP\/SRT pipelines are unchanged; importing this product does not","type":"text"},{"text":" ","type":"text"},{"text":"add VP8\/VP9 transport support.","type":"text"}],"type":"paragraph"},{"text":"Installation","anchor":"Installation","level":2,"type":"heading"},{"inlineContent":[{"text":"This product is available on main, but is not included in the released 2.3.0 package:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":[".package(url: \"https:\/\/github.com\/HaishinKit\/HaishinKit.swift.git\",","         branch: \"main\")"],"type":"codeListing"},{"inlineContent":[{"text":"Add ","type":"text"},{"code":".product(name: \"VPXHaishinKit\", package: \"HaishinKit.swift\")","type":"codeVoice"},{"text":" to your target.","type":"text"},{"text":" ","type":"text"},{"text":"After publication, replace the main branch with a release containing this product.","type":"text"}],"type":"paragraph"},{"text":"Standalone conversion","anchor":"Standalone-conversion","level":2,"type":"heading"},{"inlineContent":[{"text":"The following function needs no ","type":"text"},{"code":"import HaishinKit","type":"codeVoice"},{"text":" or shared codec registration:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import CoreMedia","import VPXHaishinKit","","func roundTrip(_ references: [CMSampleBuffer]) throws -> [CMSampleBuffer] {","    let settings = VPXVideoCodecSettings(bitRate: 1_000_000, format: .vp9)","    let encoder = try VPXVideoEncoder(settings: settings)","    let decoder = try VPXVideoDecoder(format: .vp9)","    defer { encoder.invalidate(); decoder.invalidate() }","    var restored: [CMSampleBuffer] = []","    for reference in references {","        for packet in try encoder.encode(reference) {","            restored += try decoder.decode(packet)","        }","    }","    for packet in try encoder.finish() {","        restored += try decoder.decode(packet)","    }","    return restored","}"],"type":"codeListing"},{"inlineContent":[{"code":"encode","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"decode","type":"codeVoice"},{"text":" synchronously return owned Core Media samples. Copying encoded","type":"text"},{"text":" ","type":"text"},{"text":"bytes and decoded pixels before libvpx reuses its buffers makes retained outputs safe.","type":"text"},{"text":" ","type":"text"},{"text":"The classes are deliberately non-Sendable: create and use each instance on one actor","type":"text"},{"text":" ","type":"text"},{"text":"or serial executor. Software compression runs on that caller; use a worker executor","type":"text"},{"text":" ","type":"text"},{"text":"for UI applications. The APIs throw errors directly rather than dropping outputs","type":"text"},{"text":" ","type":"text"},{"text":"through an asynchronous continuation.","type":"text"}],"type":"paragraph"},{"text":"Settings and lifecycle","anchor":"Settings-and-lifecycle","level":2,"type":"heading"},{"inlineContent":[{"text":"VP8 and VP9 use 8-bit SDR 4:2:0. The encoder accepts only video-range planar","type":"text"},{"text":" ","type":"text"},{"text":"I420 (","type":"text"},{"code":"kCVPixelFormatType_420YpCbCr8Planar","type":"codeVoice"},{"text":"), with dimensions exactly matching","type":"text"},{"text":" ","type":"text"},{"code":"videoSize","type":"codeVoice"},{"text":". It passes the three planes and their row strides directly to libvpx","type":"text"},{"text":" ","type":"text"},{"text":"while the input pixel buffer is locked. The caller is responsible for color-space","type":"text"},{"text":" ","type":"text"},{"text":"conversion, range normalization, and resizing before encoding. NV12, RGB, full-range,","type":"text"},{"text":" ","type":"text"},{"text":"10-bit, and mismatched dimensions are rejected rather than converted implicitly.","type":"text"},{"text":" ","type":"text"},{"text":"Encoded width\/height must be positive even integers, within the codec limit, and","type":"text"},{"text":" ","type":"text"},{"text":"their product must not exceed 16,777,216 pixels. VP9 high-bit-depth and 4:4:4 are not supported.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"PTS values must be numeric, epoch zero, and strictly increasing after conversion","type":"text"},{"text":" ","type":"text"},{"text":"to a microsecond timebase. Numeric positive input durations are preserved to that","type":"text"},{"text":" ","type":"text"},{"text":"precision; otherwise the frame-rate hint provides a duration. The hint must be finite","type":"text"},{"text":" ","type":"text"},{"text":"and between 0.001 and 1,000,000 fps. Keyframe intervals are timestamp-based, between","type":"text"},{"text":" ","type":"text"},{"text":"one microsecond and one hour, so skipped inputs do not extend the keyframe interval.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Compression uses realtime, zero-lookahead operation with no intentional frame drops","type":"text"},{"text":" ","type":"text"},{"text":"or frame reordering. Average and constant bitrate modes are available. Call ","type":"text"},{"code":"update","type":"codeVoice"},{"text":" ","type":"text"},{"text":"to change bitrate and frame-rate hints. Changing codec, dimensions,","type":"text"},{"text":" ","type":"text"},{"text":"bitrate mode, or keyframe interval requires a new encoder and is rejected by ","type":"text"},{"code":"update","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"code":"finish","type":"codeVoice"},{"text":" drains the encoder and rejects further input; repeated calls return no","type":"text"},{"text":" ","type":"text"},{"text":"packets. ","type":"text"},{"code":"invalidate","type":"codeVoice"},{"text":" releases resources and is safe to call repeatedly. Construct","type":"text"},{"text":" ","type":"text"},{"text":"new encoder\/decoder instances to restart.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The decoder consumes raw compressed VP8\/VP9 samples with a matching format description,","type":"text"},{"text":" ","type":"text"},{"text":"and returns NV12 frames with the packet PTS\/duration and decoded full\/video range.","type":"text"},{"text":" ","type":"text"},{"text":"The caller must demultiplex a container and supply packet timing; this module does not","type":"text"},{"text":" ","type":"text"},{"text":"read\/write MP4, IVF, or WebM files, nor add RTP\/Enhanced RTMP\/TS framing.","type":"text"},{"text":" ","type":"text"},{"text":"Only decoded pixel range is signaled here; interpreting and attaching container colorimetry remains the caller’s responsibility.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Encoding and decoding follow the package’s existing platform minimums; this module","type":"text"},{"text":" ","type":"text"},{"text":"does not depend on VideoToolbox pixel transfer. The libvpx 1.17.0 artifact supports arm64, including Apple silicon","type":"text"},{"text":" ","type":"text"},{"text":"simulators; it does not include Intel slices. Preserve the libvpx LICENSE and PATENTS","type":"text"},{"text":" ","type":"text"},{"text":"notices from libvpx-xcframework when distributing an app.","type":"text"}],"type":"paragraph"},{"text":"Encoder statistics","anchor":"Encoder-statistics","level":2,"type":"heading"},{"inlineContent":[{"text":"Read ","type":"text"},{"identifier":"doc:\/\/VPXHaishinKit\/documentation\/VPXHaishinKit\/VPXVideoEncoder\/statistics","isActive":true,"type":"reference"},{"text":" on the encoder’s actor or serial executor,","type":"text"},{"text":" ","type":"text"},{"text":"then send the value snapshot to VQMetrix’s UI, history store, or report:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let snapshot = encoder.statistics","print(snapshot.submittedFrameCount, snapshot.outputPacketCount, snapshot.encodedByteCount)","print(snapshot.lastEncodingDuration, snapshot.averageEncodingDuration,","      snapshot.maximumEncodingDuration, snapshot.totalEncodingDuration)"],"type":"codeListing"},{"inlineContent":[{"text":"Durations are monotonic wall-clock seconds inside successful native frame-encode calls,","type":"text"},{"text":" ","type":"text"},{"text":"including scheduling delays. They exclude caller conversion, input validation, output","type":"text"},{"text":" ","type":"text"},{"text":"copying, failed encode calls, and ","type":"text"},{"code":"finish()","type":"codeVoice"},{"text":" flushing. They are not CPU utilization,","type":"text"},{"text":" ","type":"text"},{"text":"thermal state, energy use, or end-to-end latency. Packet\/byte counters include drained","type":"text"},{"text":" ","type":"text"},{"text":"output. Counters live for the encoder’s lifetime, survive invalidation, and are not","type":"text"},{"text":" ","type":"text"},{"text":"reset by settings updates. Snapshots are Codable and Sendable.","type":"text"}],"type":"paragraph"},{"text":"Verification","anchor":"Verification","level":2,"type":"heading"},{"inlineContent":[{"text":"Run ","type":"text"},{"code":"swift test --filter VPXVideoCodecTests","type":"codeVoice"},{"text":" for both codec round trips, owned outputs,","type":"text"},{"text":" ","type":"text"},{"text":"keyframe timing, settings updates, unsupported input\/dimension rejection, malformed packets, and lifecycle checks.","type":"text"},{"text":" ","type":"text"},{"code":"swift run --package-path VPXHaishinKit\/Tests\/Consumer Consumer","type":"codeVoice"},{"text":" exercises a separate","type":"text"},{"text":" ","type":"text"},{"text":"SwiftPM consumer importing only the public VPX API, without linking the HaishinKit core.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The published libvpx 1.17.0 artifact includes embedded DWARF debug information in its static libraries. Retain the final app archive and matching app dSYM for symbolication.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"topicSections":[{"title":"Encoding and decoding","anchor":"Encoding-and-decoding","identifiers":["doc:\/\/VPXHaishinKit\/documentation\/VPXHaishinKit\/VPXVideoEncoder","doc:\/\/VPXHaishinKit\/documentation\/VPXHaishinKit\/VPXVideoDecoder"]},{"title":"Configuration and failures","anchor":"Configuration-and-failures","identifiers":["doc:\/\/VPXHaishinKit\/documentation\/VPXHaishinKit\/VPXVideoCodecSettings","doc:\/\/VPXHaishinKit\/documentation\/VPXHaishinKit\/VPXVideoCodecSettings\/Format-swift.enum","doc:\/\/VPXHaishinKit\/documentation\/VPXHaishinKit\/VPXVideoCodecSettings\/BitRateMode-swift.enum","doc:\/\/VPXHaishinKit\/documentation\/VPXHaishinKit\/VPXVideoCodecError"]},{"title":"Measurement","anchor":"Measurement","identifiers":["doc:\/\/VPXHaishinKit\/documentation\/VPXHaishinKit\/VPXVideoEncoderStatistics"]}],"hierarchy":{"paths":[[]]},"references":{"doc://VPXHaishinKit/documentation/VPXHaishinKit/VPXVideoCodecSettings":{"identifier":"doc:\/\/VPXHaishinKit\/documentation\/VPXHaishinKit\/VPXVideoCodecSettings","abstract":[{"text":"Settings for standalone, 8-bit software VP8\/VP9 compression.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"VPXVideoCodecSettings","kind":"identifier"}],"role":"symbol","kind":"symbol","navigatorTitle":[{"text":"VPXVideoCodecSettings","kind":"identifier"}],"url":"\/documentation\/vpxhaishinkit\/vpxvideocodecsettings","title":"VPXVideoCodecSettings","type":"topic"},"doc://VPXHaishinKit/documentation/VPXHaishinKit/VPXVideoCodecSettings/Format-swift.enum":{"identifier":"doc:\/\/VPXHaishinKit\/documentation\/VPXHaishinKit\/VPXVideoCodecSettings\/Format-swift.enum","abstract":[{"text":"The compressed bitstream format.","type":"text"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Format","kind":"identifier"}],"role":"symbol","kind":"symbol","navigatorTitle":[{"text":"Format","kind":"identifier"}],"url":"\/documentation\/vpxhaishinkit\/vpxvideocodecsettings\/format-swift.enum","title":"VPXVideoCodecSettings.Format","type":"topic"},"vpxhaishinkit-icon.png":{"variants":[{"url":"\/images\/VPXHaishinKit\/vpxhaishinkit-icon.png","traits":["1x","light"]}],"type":"image","identifier":"vpxhaishinkit-icon.png","alt":"Stacked video frames for VP8 and VP9"},"doc://VPXHaishinKit/documentation/VPXHaishinKit/VPXVideoEncoder/statistics":{"title":"statistics","abstract":[{"text":"Current lifetime statistics. Read on the same actor or serial executor as encode calls.","type":"text"},{"text":" ","type":"text"},{"text":"Copy this Sendable value to forward a snapshot to a UI, history store, or report.","type":"text"}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"statistics","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:13VPXHaishinKit25VPXVideoEncoderStatisticsV","text":"VPXVideoEncoderStatistics","kind":"typeIdentifier"}],"kind":"symbol","identifier":"doc:\/\/VPXHaishinKit\/documentation\/VPXHaishinKit\/VPXVideoEncoder\/statistics","url":"\/documentation\/vpxhaishinkit\/vpxvideoencoder\/statistics","type":"topic","role":"symbol"},"doc://VPXHaishinKit/documentation/VPXHaishinKit/VPXVideoEncoderStatistics":{"navigatorTitle":[{"kind":"identifier","text":"VPXVideoEncoderStatistics"}],"title":"VPXVideoEncoderStatistics","abstract":[{"type":"text","text":"A value snapshot of one encoder’s lifetime counters, suitable for reports and cross-actor transfer."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"VPXVideoEncoderStatistics"}],"kind":"symbol","identifier":"doc:\/\/VPXHaishinKit\/documentation\/VPXHaishinKit\/VPXVideoEncoderStatistics","url":"\/documentation\/vpxhaishinkit\/vpxvideoencoderstatistics","type":"topic","role":"symbol"},"vpxhaishinkit-card.png":{"variants":[{"url":"\/images\/VPXHaishinKit\/vpxhaishinkit-card.png","traits":["1x","light"]}],"type":"image","identifier":"vpxhaishinkit-card.png","alt":"Stacked video frames for VP8 and VP9"},"doc://VPXHaishinKit/documentation/VPXHaishinKit/VPXVideoCodecSettings/BitRateMode-swift.enum":{"navigatorTitle":[{"text":"BitRateMode","kind":"identifier"}],"title":"VPXVideoCodecSettings.BitRateMode","abstract":[{"text":"The libvpx rate-control strategy. Neither mode guarantees an exact bitrate.","type":"text"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BitRateMode","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/VPXHaishinKit\/documentation\/VPXHaishinKit\/VPXVideoCodecSettings\/BitRateMode-swift.enum","url":"\/documentation\/vpxhaishinkit\/vpxvideocodecsettings\/bitratemode-swift.enum","type":"topic","role":"symbol"},"doc://VPXHaishinKit/documentation/VPXHaishinKit/VPXVideoDecoder":{"navigatorTitle":[{"text":"VPXVideoDecoder","kind":"identifier"}],"title":"VPXVideoDecoder","abstract":[{"text":"A synchronous decoder. Returned frames own their pixel storage; calls must be serialized.","type":"text"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"VPXVideoDecoder","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/VPXHaishinKit\/documentation\/VPXHaishinKit\/VPXVideoDecoder","url":"\/documentation\/vpxhaishinkit\/vpxvideodecoder","type":"topic","role":"symbol"},"doc://VPXHaishinKit/documentation/VPXHaishinKit":{"title":"VPXHaishinKit","abstract":[{"text":"Standalone software VP8 and VP9 encoding and decoding.","type":"text"}],"kind":"symbol","url":"\/documentation\/vpxhaishinkit","identifier":"doc:\/\/VPXHaishinKit\/documentation\/VPXHaishinKit","type":"topic","role":"collection","images":[{"type":"icon","identifier":"vpxhaishinkit-icon.png"},{"type":"card","identifier":"vpxhaishinkit-card.png"}]},"doc://VPXHaishinKit/documentation/VPXHaishinKit/VPXVideoEncoder":{"navigatorTitle":[{"kind":"identifier","text":"VPXVideoEncoder"}],"title":"VPXVideoEncoder","abstract":[{"type":"text","text":"A synchronous encoder. Confine the instance and its calls to one actor or serial executor."}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"VPXVideoEncoder"}],"kind":"symbol","identifier":"doc:\/\/VPXHaishinKit\/documentation\/VPXHaishinKit\/VPXVideoEncoder","url":"\/documentation\/vpxhaishinkit\/vpxvideoencoder","type":"topic","role":"symbol"},"doc://VPXHaishinKit/documentation/VPXHaishinKit/VPXVideoCodecError":{"navigatorTitle":[{"text":"VPXVideoCodecError","kind":"identifier"}],"title":"VPXVideoCodecError","abstract":[{"text":"A standalone codec failure. Unsupported configurations never select another codec.","type":"text"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"VPXVideoCodecError","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/vpxhaishinkit\/vpxvideocodecerror","identifier":"doc:\/\/VPXHaishinKit\/documentation\/VPXHaishinKit\/VPXVideoCodecError","type":"topic","role":"symbol"}}}