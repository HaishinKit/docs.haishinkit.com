{"sections":[],"identifier":{"url":"doc:\/\/MoQTHaishinKit\/documentation\/MoQTHaishinKit","interfaceLanguage":"swift"},"hierarchy":{"paths":[[]]},"abstract":[{"type":"text","text":"This module supports the MoQT protocol."}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"MoQTHaishinKit implements the native QUIC client subset of"},{"type":"text","text":" "},{"identifier":"https:\/\/datatracker.ietf.org\/doc\/html\/draft-ietf-moq-transport-23","type":"reference","isActive":true},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Connection APIs require iOS 16, macOS 13, or tvOS 16."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Connect to a "},{"type":"codeVoice","code":"moqt:\/\/"},{"type":"text","text":" endpoint and consume "},{"type":"codeVoice","code":"objectStream"},{"type":"text","text":" for incoming"},{"type":"text","text":" "},{"type":"text","text":"subgroup objects and datagrams."}]},{"syntax":"swift","code":["let connection = MoQTConnection(.subscriber)","let objects = await connection.objectStream","_ = try await connection.connect(\"moqt:\/\/relay.example\/live\")","","do {","    let subscription = try await connection.subscribe([\"live\"], name: \"video\")","    print(subscription.trackAlias)","} catch let rejection as MoQTRequestError {","    print(rejection.code, rejection.reasonPhrase)","}","","for await object in objects {","    \/\/ Use object.trackAlias to identify the subscription.","    print(object.id)","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"code":"publishNamespace","type":"codeVoice"},{"type":"text","text":" to advertise a namespace and "},{"code":"subscribeNamespace","type":"codeVoice"},{"type":"text","text":" to"},{"type":"text","text":" "},{"type":"text","text":"receive namespace discovery updates. Both throw "},{"code":"MoQTRequestError","type":"codeVoice"},{"type":"text","text":" when the"},{"type":"text","text":" "},{"type":"text","text":"peer rejects the request. For authenticated requests, supply a"},{"type":"text","text":" "},{"code":"MoQTAuthorizationToken","type":"codeVoice"},{"text":" with the token type and bytes expected by the peer.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"type":"codeVoice","code":"fetch(_:name:range:authorizationToken:)"},{"text":" to retrieve stored objects in","type":"text"},{"text":" ","type":"text"},{"text":"ascending group order. Each fetch returns its own asynchronous object stream.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"code":"subscribeTracks(_:authorizationToken:)","type":"codeVoice"},{"text":" to subscribe by namespace prefix.","type":"text"},{"text":" ","type":"text"},{"text":"The client accepts matching PUBLISH requests associated with the prefix","type":"text"},{"text":" ","type":"text"},{"text":"subscription and reports them through the returned event stream. Live objects","type":"text"},{"text":" ","type":"text"},{"text":"arrive on ","type":"text"},{"code":"objectStream","type":"codeVoice"},{"text":" and carry the assigned track alias.","type":"text"}]},{"inlineContent":[{"text":"Use ","type":"text"},{"code":"setPaused(_:trackAlias:)","type":"codeVoice"},{"text":" to change an active subscription’s pause state","type":"text"},{"type":"text","text":" "},{"text":"with REQUEST_UPDATE. The local state changes after the peer acknowledges it.","type":"text"},{"text":" ","type":"text"},{"text":"For outgoing publications, use ","type":"text"},{"code":"publish(_:name:trackAlias:authorizationToken:)","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"send subgroup objects using that alias, and call "},{"code":"finishPublishing(trackAlias:)","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Incoming REQUEST_UPDATE messages can pause or resume those publications.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"This client supports pause and resume updates. Other update parameters,","type":"text"},{"text":" ","type":"text"},{"text":"unsolicited incoming publications, serving incoming FETCH and SUBSCRIBE_TRACKS","type":"text"},{"text":" ","type":"text"},{"text":"requests, WebTransport, automatic session migration, and relay behavior are","type":"text"},{"text":" ","type":"text"},{"text":"outside the implemented subset.","type":"text"}],"type":"paragraph"}]}],"metadata":{"externalID":"MoQTHaishinKit","modules":[{"name":"MoQTHaishinKit"}],"title":"MoQTHaishinKit","roleHeading":"Framework","symbolKind":"module","images":[{"identifier":"moqthaishinkit-icon.svg","type":"icon"},{"identifier":"moqthaishinkit-card.svg","type":"card"}],"role":"collection"},"variants":[{"paths":["\/documentation\/moqthaishinkit"],"traits":[{"interfaceLanguage":"swift"}]}],"topicSections":[{"title":"Classes","identifiers":["doc:\/\/MoQTHaishinKit\/documentation\/MoQTHaishinKit\/MoQTConnection"],"generated":true,"anchor":"Classes"},{"title":"Structures","identifiers":["doc:\/\/MoQTHaishinKit\/documentation\/MoQTHaishinKit\/MoQTAuthorizationToken","doc:\/\/MoQTHaishinKit\/documentation\/MoQTHaishinKit\/MoQTFetchRange","doc:\/\/MoQTHaishinKit\/documentation\/MoQTHaishinKit\/MoQTGoAway","doc:\/\/MoQTHaishinKit\/documentation\/MoQTHaishinKit\/MoQTKeyValue","doc:\/\/MoQTHaishinKit\/documentation\/MoQTHaishinKit\/MoQTObject","doc:\/\/MoQTHaishinKit\/documentation\/MoQTHaishinKit\/MoQTPublishedTrack","doc:\/\/MoQTHaishinKit\/documentation\/MoQTHaishinKit\/MoQTRequestError","doc:\/\/MoQTHaishinKit\/documentation\/MoQTHaishinKit\/MoQTRequestOk","doc:\/\/MoQTHaishinKit\/documentation\/MoQTHaishinKit\/MoQTRequestState","doc:\/\/MoQTHaishinKit\/documentation\/MoQTHaishinKit\/MoQTSetup","doc:\/\/MoQTHaishinKit\/documentation\/MoQTHaishinKit\/MoQTStreamHeade