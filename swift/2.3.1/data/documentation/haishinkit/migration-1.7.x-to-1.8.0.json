{"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"This is a historical migration guide. Code examples refer to the versions shown in each section and may not match the current release.","type":"text"}]},{"level":3,"anchor":"IOStreamattachAudio","type":"heading","text":"IOStream#attachAudio"},{"level":4,"anchor":"170","type":"heading","text":"1.7.0"},{"code":["stream.attachAudio(AVCaptureDevice.default(for: .audio), automaticallyConfiguresApplicationAudioSession: true) { error in","    \/\/ print(error)","}"],"syntax":"swift","type":"codeListing"},{"level":4,"anchor":"180","type":"heading","text":"1.8.0"},{"code":["stream.configuration { session in","    session.automaticallyConfiguresApplicationAudioSession = true","}","","stream.attachAudio(AVCaptureDevice.default(for: .audio), track: 0) { unit, error in","}"],"syntax":"swift","type":"codeListing"},{"level":3,"anchor":"IOStreamattachVideo","type":"heading","text":"IOStream#attachVideo"},{"level":4,"anchor":"170","type":"heading","text":"1.7.0"},{"code":["stream.attachCamera(AVCaptureDevice.default(.builtInWideAngleCamera, for: .video, position: .back), channel: 0) { _, error in","  if let error {","    logger.warn(error)","  }","}"],"syntax":"swift","type":"codeListing"},{"level":4,"anchor":"180","type":"heading","text":"1.8.0"},{"code":["stream.attachCamera(AVCaptureDevice.default(.builtInWideAngleCamera, for: .video, position: .back), track: 0) { _, error in","  if let error {","    logger.warn(error)","  }","}"],"syntax":"swift","type":"codeListing"},{"level":3,"anchor":"IOStreamDelegate","type":"heading","text":"IOStreamDelegate"},{"level":4,"anchor":"170","type":"heading","text":"1.7.0"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Removed."}]},{"code":["\/\/\/ The interface an IOStream uses to inform its delegate.","public protocol IOStreamDelegate: AnyObject {","    \/\/\/ Tel