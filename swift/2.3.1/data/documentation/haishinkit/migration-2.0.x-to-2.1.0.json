","type":"heading","anchor":"21x"},{"code":["import HaishinKit","import RTMPHaishinKit","","let connection = RTMPConnection()"],"type":"codeListing","syntax":"swift"},{"level":4,"text":"Package Manager","type":"heading","anchor":"Package-Manager"},{"inlineContent":[{"isActive":true,"identifier":"https:\/\/github.com\/HaishinKit\/HaishinKit.swift\/discussions\/1672","type":"reference"},{"text":", support for CocoaPods has been discontinued.","type":"text"}],"type":"paragraph"},{"level":5,"text":"2.0.x","type":"heading","anchor":"20x"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"CocoaPods"}],"type":"paragraph"}],"checked":true},{"content":[{"inlineContent":[{"type":"text","text":"SwiftPM"}],"type":"paragraph"}],"checked":true}]},{"level":5,"text":"2.1.0","type":"heading","anchor":"210"},{"type":"unorderedList","items":[{"checked":true,"content":[{"type":"paragraph","inlineContent":[{"text":"SwiftPM","type":"text"}]}]}]},{"level":3,"type":"heading","anchor":"MediaMixer","text":"MediaMixer"},{"level":4,"type":"heading","anchor":"Change-in-behavior","text":"Change in behavior"},{"type":"paragraph","inlineContent":[{"text":"Since around iOS 18, when attaching a device during capture with AVCaptureMultiCamSession, the application’s UI becomes locked for several seconds. To address this, we have changed the behavior to start capture manually.","type":"text"}]},{"level":5,"type":"heading","anchor":"20x","text":"2.0.x"},{"syntax":"swift","type":"codeListing","code":["import HaishinKit","","let mixer = MediaMixer()","\/\/ Capture was automatically started under certain conditions.","await mixer.attachVideo(AVCaptureDevice.default(.builtInWideAngleCamera, for: .video, position: .back))","await mixer.addOutput(view)"]},{"level":5,"type":"heading","anchor":"210","text":"2.1.0"},{"syntax":"swift","type":"codeListing","code":["import HaishinKit","","let mixer = MediaMixer()","await mixer.attachVideo(AVCaptureDevice.default(.builtInWideAngleCamera, for: .video, position: .back))","await mixer.addOutput(view)","","\/\/ Calling startRunning() is now required.","await mixer.startRunning()"]},{"level":4,"type":"heading","anchor":"frameRate","text":"frameRate"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Frame rate specification has been changed to allow separate settings for output configuration and camera input."}]},{"level":5,"type":"heading","anchor":"20x","text":"2.0.x"},{"syntax":"swift","type":"codeListing","code":["await mixer.setFrameRate(fps)"]},{"level":5,"type":"heading","anchor":"210","text":"2.1.0"},{"syntax":"swift","type":"codeListing","code":["\/\/ Sets to video camera capture frameRate.","try? await mixer.configuration(video: 0) { video in","  do {","    try video.setFrameRate(fps)","  } catch {","    logger.error(error)","  }","}","","\/\/ Sets to output frameRate.","try await mixer.setFrameRate(fps)"]}]}],"references":{"doc://HaishinKit/documentation/HaishinKit/migration-guide":{"title":"Migration Guide","url":"\/documentation\/haishinkit\/migration-guide","identifier":"doc:\/\/HaishinKit\/documentation\/HaishinKit\/migration-guide","role":"collectionGroup","kind":"article","abstract":[{"text":"Find the API changes and code examples for upgrading between HaishinKit versions.","type":"text"}],"type":"topic"},"doc://HaishinKit/documentation/HaishinKit/migration-2.2.x-to-2.3.x":{"title":"Moving from 2.2.x APIs to 2.3.x","url":"\/documentation\/haishinkit\/migration-2.2.x-to-2.3.x","identifier":"doc:\/\/HaishinKit\/documentation\/HaishinKit\/migration-2.2.x-to-2.3.x","role":"article","kind":"article","abstract":[{"text":"Update session types and screen rendering code for the upcoming 2.3.x release.","type":"text"}],"type":"topic"},"doc://HaishinKit/documentation/HaishinKit":{"url":"\/documentation\/haishinkit","type":"topic","images":[{"type":"icon","identifier":"haishinkit-app-icon.png"},{"type":"card","identifier":"haishinkit-card.svg"}],"identifier":"doc:\/\/HaishinKit\/do