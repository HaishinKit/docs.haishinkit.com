{"sections":[],"hierarchy":{"paths":[["doc:\/\/HaishinKit\/documentation\/HaishinKit"]]},"metadata":{"title":"macOS debug application","roleHeading":"Article","modules":[{"name":"HaishinKit"}],"role":"article"},"identifier":{"url":"doc:\/\/HaishinKit\/documentation\/HaishinKit\/macOS-debug-app","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"paths":["\/documentation\/haishinkit\/macos-debug-app"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Run-the-app","text":"Run the app","level":2},{"inlineContent":[{"type":"text","text":"Open "},{"type":"codeVoice","code":"Examples\/Examples.xcworkspace"},{"type":"text","text":" and run the "},{"type":"codeVoice","code":"Example macOS"},{"type":"text","text":" scheme. The"},{"type":"text","text":" "},{"type":"text","text":"workspace uses the library in the same checkout. Release ZIPs target Apple"},{"type":"text","text":" "},{"text":"Silicon and require macOS 15.5 or later.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Publish-and-inspect","type":"heading","text":"Publish and inspect"},{"inlineContent":[{"text":"Use ","type":"text"},{"type":"strong","inlineContent":[{"text":"Publish","type":"text"}]},{"text":" for a camera preview, screen sharing, scene overlay editing,","type":"text"},{"text":" ","type":"text"},{"text":"frame-rate changes, and monochrome effects. ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Encoder"}]},{"text":" controls set the output","type":"text"},{"text":" ","type":"text"},{"text":"resolution, codec, video\/audio target bitrates, and hardware encoding for the","type":"text"},{"text":" ","type":"text"},{"text":"next publishing session. ","type":"text"},{"type":"strong","inlineContent":[{"text":"Settings","type":"text"}]},{"text":" contains audio format, bitrate mode, and","type":"text"},{"text":" ","type":"text"},{"text":"low-latency options.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The preview canvas is 1280 × 720; encoder output resolution is configured","type":"text"},{"text":" ","type":"text"},{"text":"separately. Target video bitrate is a setting, not a measured throughput value.","type":"text"},{"text":" ","type":"text"},{"text":"Measured TX and send queue use transport reports where the selected protocol","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"provides them. Output FPS is currently available for RTMP. A dash means a"},{"text":" ","type":"text"},{"text":"measurement is unavailable, including before a session starts.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Share screen or window…"}]},{"text":" opens the system ScreenCaptureKit picker. Choose a","type":"text"},{"text":" ","type":"text"},{"text":"display, window, or application. Captured video replaces the camera on mixer","type":"text"},{"text":" ","type":"text"},{"text":"track 0; overlays and effects still apply. Audio continues to come from the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"microphone when enabled in "},{"inlineContent":[{"text":"Settings → Capture","type":"text"}],"type":"strong"},{"text":". Microphone capture is off by","type":"text"},{"text":" ","type":"text"},{"text":"default so video-only debugging does not open an audio device. Camera and","type":"text"},{"text":" ","type":"text"},{"text":"microphone access must be granted before their capture devices are opened.","type":"text"},{"text":" ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Stop sharing · Use camera"}]},{"text":" restores authorized camera capture. Sharing stops","type":"text"},{"text":" ","type":"text"},{"text":"when the publishing view closes.","type":"text"}]},{"anchor":"Receive-SRT-on-the-local-network","level":2,"type":"heading","text":"Receive SRT on the local network"},{"inlineContent":[{"type":"text","text":"In "},{"type":"strong","inlineContent":[{"type":"text","text":"Playback"}]},{"type":"text","text":", enter a receive port and choose "},{"type":"strong","inlineContent":[{"type":"text","text":"Listen for SRT sender"}]},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"After the SRT socket is listening, the app announces a Bonjour service:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Type: "},{"type":"codeVoice","code":"_srt._udp."},{"type":"text","text":" in "},{"type":"codeVoice","code":"local."}]}]},{"content":[{"inlineContent":[{"text":"Port: the selected SRT port.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"TXT: "},{"type":"codeVoice","code":"role=receiver"},{"type":"text","text":", "},{"type":"codeVoice","code":"version=1"},{"type":"text","text":"."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"The sending client resolves the service address and connects using","type":"text"},{"text":" ","type":"text"},{"code":"srt:\/\/<resolved-host>:<port>?mode=caller","type":"codeVoice"},{"text":", sending MPEG-TS with supported","type":"text"},{"text":" ","type":"text"},{"text":"video\/audio codecs. One sender is accepted per listener. The announcement is","type":"text"},{"type":"text","text":" "},{"type":"text","text":"removed once a sender connects or listening stops. Choose "},{"inlineContent":[{"text":"Cancel receiving","type":"text"}],"type":"strong"},{"type":"text","text":" "},{"type":"text","text":"to stop waiting, or "},{"inlineContent":[{"type":"text","text":"Stop playback"}],"type":"strong"},{"text":" to close an established connection.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For a local smoke test, start listening on port 9000 and send a generated test"},{"type":"text","text":" "},{"type":"text","text":"pattern with FFmpeg built with SRT support:"}]},{"code":["ffmpeg -re -f lavfi -i testsrc2=size=640x360:rate=30 \\","  -f lavfi -i sine=frequency=440:sample_rate=48000 \\","  -c:v libx264 -preset ultrafast -tune zerolatency -pix_fmt yuv420p \\","  -c:a aac -f mpegts 'srt:\/\/127.0.0.1:9000?mode=caller'"],"syntax":"sh","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Find Bonjour services","type":"text"}]},{"type":"text","text":" searches for "},{"code":"_srt._udp","type":"codeVoice"},{"type":"text","text":" sources and connects in"},{"type":"text","text":" "},{"type":"text","text":"caller\/playback mode. Receiver-only advertisements are excluded from the source"},{"text":" ","type":"text"},{"text":"list. Bonjour discovery is an opt-in convention used by this example; arbitrary","type":"text"},{"type":"text","text":" "},{"type":"text","text":"SRT servers do not automatically advertise themselves. Local network access"},{"type":"text","text":" "},{"type":"text","text":"must be allowed, and both peers must be on a network that permits mDNS and SRT."}]},{"type":"heading","level":2,"anchor":"Debug-tools-and-HTTP-signaling","text":"Debug tools and HTTP signaling"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Debug"}],"type":"strong"},{"type":"text","text":" provides verbose library logging and a publish-view sheet for repeated"},{"type":"text","text":" "},{"type":"text","text":"open\/dismiss memory-release checks with Instruments. Debug logs can contain"},{"type":"text","text":" "},{"type":"text","text":"endpoint URLs and signaling data."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The WHIP\/WHEP presets construct client endpoints for a separately running"},{"type":"text","text":" "},{"type":"text","text":"MediaMTX server. WHIP selects Opus audio. MediaMTX setup and WebRTC network"},{"text":" ","type":"text"},{"text":"requirements are documented in the ","type":"text"},{"identifier":"https:\/\/mediamtx.org\/docs\/features\/publish-and-read","isActive":true,"type":"reference"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"The example permits plain HTTP to support local test servers; configure secure"},{"type":"text","text":" "},{"type":"text","text":"transport and authentication separately for production applications."}]}]}],"abstract":[{"text":"Exercise capture, encoding, transport, and playback in the macOS Example app.","type":"text"}],"kind":"article","references":{"haishinkit-app-icon.png":{"alt":"HaishinKit app icon","identifier":"haishinkit-app-icon.png","variants":[{"url":"\/images\/HaishinKit\/haishinkit-app-icon.png","traits":["1x","light"]}],"type":"image"},"doc://HaishinKit/documentation/HaishinKit":{"url":"\/documentation\/haishinkit","type":"topic","images":[{"type":"icon","identifier":"haishinkit-app-icon.png"},{"type":"card","identifier":"haishinkit-card.svg"}],"identifier":"doc:\/\/HaishinKit\/documentation\/HaishinKit","title":"HaishinKit","role":"collection","abstract":[{"text":"This is the main module.","type":"text"}],"kind":"symbol"},"haishinkit-card.svg":{"variants":[{"traits":["1x","light"],"url":"\/images\/HaishinKit\/haishinkit-card.svg"}],"identifier":"haishinkit-card.svg","type":"image","alt":"HaishinKit app icon"},"https://mediamtx.org/docs/features/publish-and-read":{"titleInlineContent":[{"type":"text","text":"MediaMTX reference"}],"title":"MediaMTX reference","type":"link","identifier":"https:\/\/mediamtx.org\/docs\/features\/publish-and-read","url":"https:\/\/mediamtx.org\/docs\/features\/publish-and-read"}}}