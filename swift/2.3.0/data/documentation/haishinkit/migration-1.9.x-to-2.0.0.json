{"abstract":[{"text":"Update code written for HaishinKit 1.9.x to use the 2.0.0 APIs.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/HaishinKit\/documentation\/HaishinKit","doc:\/\/HaishinKit\/documentation\/HaishinKit\/migration-guide"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/HaishinKit\/documentation\/HaishinKit\/migration-1.9.x-to-2.0.0"},"seeAlsoSections":[{"anchor":"Migrating-to-2x","generated":true,"title":"Migrating to 2.x","identifiers":["doc:\/\/HaishinKit\/documentation\/HaishinKit\/migration-2.2.x-to-2.3.x","doc:\/\/HaishinKit\/documentation\/HaishinKit\/migration-2.0.x-to-2.1.0"]}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"text":"This is a historical migration guide. Code examples refer to the versions shown in each section and may not match the current release.","type":"text"}],"type":"paragraph"},{"anchor":"IOStream","text":"IOStream","level":3,"type":"heading"},{"inlineContent":[{"text":"I redesigned the system to address the demand for streaming to multiple services. The responsibilities are split into ","type":"text"},{"isActive":true,"identifier":"https:\/\/docs.haishinkit.com\/swift\/2.0.0\/Actors\/MediaMixer.html","type":"reference"},{"text":", which handles capture from the device, and ","type":"text"},{"isActive":true,"identifier":"https:\/\/docs.haishinkit.com\/swift\/2.0.0\/Protocols\/HKStream.html","type":"reference"},{"text":", which focuses on live streaming video and audio.","type":"text"}],"type":"paragraph"},{"anchor":"Attaching-the-view","text":"Attaching the view","level":4,"type":"heading"},{"anchor":"19x","text":"1.9.x","level":5,"type":"heading"},{"code":["stream = IOStream()","view = MTHKView()","","view.attachStream(stream)"],"type":"codeListing","syntax":"swift"},{"anchor":"200","text":"2.0.0","level":5,"type":"heading"},{"code":["mixer = MediaMixer()","stream = HKStream()","view = MTHKView()","\/\/ view2 = MTHKView()","","mixer.addOutput(stream)","stream.addOutput(view)","\/\/ stream.addOutput(view2)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"It is possible to set multiple views on the mixer. This allows you to directly monitor the video CMSampleBuffer during capture. You can switch between views by changing the track. Setting track = UInt8.max makes it equivalent to the value being output to HKStream.","type":"text"}],"type":"paragraph"},{"code":["mixer = MediaMixer()","view0 = MTHKView()","view1 = MTHKView()","","view0.videoTrackId = 0","view1.videoTrackId = UInt8.max","","mixer.addOutput(view0)","mixer.addOutput(view1)"],"type":"codeListing","syntax":"swift"},{"anchor":"attachCamera-attachAudio","text":"attachCamera, attachAudio","level":4,"type":"heading"},{"anchor":"19x","text":"1.9.x","level":5,"type":"heading"},{"code":["stream = IOStream()","","stream.attachCamera(AVCaptureDevice.default(.builtInWideAngleCamera, for: .video, position: .back), track: 0) { _, error in","  if let error {","    logger.warn(error)","  }","}","","stream.attachAudio(AVCaptureDevice.default(for: .audio)) { _, error in","  if let error {","    logger.warn(error)","  }","}"],"type":"codeListing","syntax":"swift"},{"code":["guard","  let device = stream.videoCapture(for: 0)?.device, device.isFocusPointOfInterestSupported else {","  return","}","do {","  try device.lockForConfiguration()","  device.focusPointOfInterest = pointOfInterest","  device.focusMode = .continuousAutoFocus","  device.unlockForConfiguration()","} catch let error as NSError {","  logger.error(\"while locking device for focusPointOfInterest: \\(error)\")","            }"],"type":"codeListing","syntax":"swift"},{"anchor":"20x","text":"2.0.x","level":5,"type":"heading"},{"code":["mixer = MediaMixer()","stream = RTMPStream() \/\/ or SRTStream","","do {","  try await mixer.attachVideo(AVCaptureDevice.default(.builtInWideAngleCamera, for: .video, position: .back))","} catch {","  logger.warn(error)","}","","do {","  try await mixer.attachAudio(AVCaptureDevice.default(for: .audio))","} catch {","  logger.warn(error)","}","","mixer.addOutput(stream)"],"type":"codeListing","syntax":"swift"},{"code":["try await mixer.configuration(video: 0) { unit in","  guard let device = unit.device else {","    return","  }","  try device.lockForConfiguration()","  device.focusPointOfInterest = pointOfInterest","  device.focusMode = .continuousAutoFocus","  device.unlockForConfiguration()","}"],"type":"codeListing","syntax":"swift"},{"anchor":"Playback","text":"Playback","level":4,"type":"heading"},{"inlineContent":[{"type":"text","text":"If you want to play audio, please attach a single-instance AudioPlayer. AudioPlayer is a wrapper for AVAudioEngine."}],"type":"paragraph"},{"anchor":"19x","text":"1.9.x","level":5,"type":"heading"},{"code":["stream = RTMPStream()","","stream.play(\"streamName\")"],"type":"codeListing","syntax":"swift"},{"anchor":"20x","text":"2.0.x","level":5,"type":"heading"},{"code":["audioPlayer = AudioPlauer(AVAudioEngine())","","stream = RTMPStream()","stream.attachAudioPlayer(audioPlayer)","","stream.play(\"streamName\")"],"type":"codeListing","syntax":"swift"},{"anchor":"Recording","text":"Recording","level":4,"type":"heading"},{"anchor":"19x","text":"1.9.x","level":5,"type":"heading"},{"code":["stream = RTMPStream()","recorder = IOStreamRecorder()","stream.addObserver(recorder)","","recorder.delegate = self","recorder.startRunning()","recorder.stopRunning()","","extension IngestViewController: IOStreamRecorderDelegate {","  \/\/ MARK: IOStreamRecorderDelegate","  func recorder(_ recorder: IOStreamRecorder, errorOccured error: IOStreamRecorder.Error) {","    logger.error(error)","  }","","  func recorder(_ recorder: IOStreamRecorder, finishWriting writer: AVAssetWriter) {","    PHPhotoLibrary.shared().performChanges({() -> Void in","      PHAssetChangeRequest.creationRequestForAssetFromVideo(atFileURL: writer.outputURL)","    }, completionHandler: { _, error -> Void in","      try? FileManager.default.removeItem(at: writer.outputURL)","    })","  }","}"],"type":"codeListing","syntax":"swift"},{"anchor":"200","text":"2.0.0","level":5,"type":"heading"},{"code":["stream = RTMPStream() \/\/ or SRTStream()","recorder = HKStreamRecorder()","","stream.addOutput(recorder)","","do {","  try await recorder.startRecording()","} catch {","  print(error)","}","","do {","  let outputURL = try await recorder.stopRecording()","  PHPhotoLibrary.shared().performChanges({() -> Void in","    PHAssetChangeRequest.creationRequestForAssetFromVideo(atFileURL: outputURL)","  }, completionHandler: { _, error -> Void in","    try? FileManager.default.removeItem(at: outputURL)","  })","} catch {","  print(error)","}"],"type":"codeListing","syntax":"swift"},{"anchor":"RTMP","text":"RTMP","level":3,"type":"heading"},{"anchor":"Discontinued","text":"Discontinued","level":4,"type":"heading"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"RTMPT, RTMPTS protocols."}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"I decided this because I judged the usage frequency to be low."}]}]}],"type":"unorderedList"}]}]},{"anchor":"Signature","text":"Signature","level":4,"type":"heading"},{"inlineContent":[{"type":"text","text":"Inheritance is no longer possible due to the transition to actors. If you were using inheritance and are now facing issues, please let us know how you were using it, and I can discuss possible solutions."}],"type":"paragraph"},{"alignments":["left","left"],"header":"row","type":"table","rows":[[[{"inlineContent":[{"text":"1.9.x","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"2.0.0","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"public class RTMPConnection","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"actor RTMPConnection","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"open class RTMPStream","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"actor RTMPStream","type":"text"}],"type":"paragraph"}]]]},{"anchor":"RTMPConnection","text":"RTMPConnection","level":4,"type":"heading"},{"inlineContent":[{"type":"text","text":"Regarding the specification of detailed properties."}],"type":"paragraph"},{"anchor":"19x","text":"1.9.x","level":5,"type":"heading"},{"code":["public actor RTMPConnection {","  \/\/\/ Specifies the URL of .swf.","  public var swfUrl: String?","  \/\/\/ Specifies the URL of an HTTP referer.","  public var pageUrl: String?","  \/\/\/ Specifies the time to wait for TCP\/IP Handshake done.","  ...","}"],"type":"codeListing","syntax":"swift"},{"anchor":"20x","text":"2.0.x","level":5,"type":"heading"},{"inlineContent":[{"type":"text","text":"The constructor now accepts it as an argument."}],"type":"paragraph"},{"code":["public actor RTMPConnection {","  \/\/\/ The URL of .swf.","  public let swfUrl: String?","  \/\/\/ The URL of an HTTP referer.","  public let pageUrl: String?","  \/\/\/ The name of application.","  public let flashVer: String","  \/\/\/ The time to wait for TCP\/IP Handshake done.","  public let timeout: Int","  \/\/\/ The RTMP request timeout value. Defaul value is 500 msec.","  public let requestTimeout: UInt64","  \/\/\/ The outgoing RTMPChunkSize.","  public let chunkSize: Int","  \/\/\/ The dispatchQos for socket.","  public let qualityOfService: DispatchQoS","","  \/\/\/ Creates a new connection.","  public init(","    swfUrl: String? = nil,","    pageUrl: String? = nil,","    flashVer: String = RTMPConnection.defaultFlashVer,","    timeout: Int = RTMPConnection.defaultTimeout,","    requestTimeout: UInt64 = RTMPConnection.defaultRequestTimeout,","    chunkSize: Int = RTMPConnection.defaultChunkSizeS,","    qualityOfService: DispatchQoS = .userInitiated) {","    self.swfUrl = swfUrl","    self.pageUrl = pageUrl","    self.flashVer = flashVer","    self.timeout = timeout","    self.requestTimeout = requestTimeout","    self.chunkSize = chunkSize","    self.qualityOfService = qualityOfService","  }","}"],"type":"codeListing","syntax":"swift"},{"anchor":"EventHandle","text":"EventHandle","level":4,"type":"heading"},{"anchor":"19x","text":"1.9.x","level":5,"type":"heading"},{"inlineContent":[{"type":"text","text":"Discontinued event handling related to "},{"code":"addEventHandler","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["connection.addEventListener(.rtmpStatus, selector: #selector(rtmpStatusHandler), observer: self)","connection.addEventListener(.ioError, selector: #selector(rtmpErrorHandler), observer: self)","","@objc","private func rtmpStatusHandler(_ notification: Notification) {","  let e = Event.from(notification)","  guard let data: ASObject = e.data as? ASObject, let code: String = data[\"code\"] as? String else {","    return","  }","  logger.info(code)","  switch code {","  case RTMPConnection.Code.connectSuccess.rawValue:","    stream?.publish(Preference.default.streamName!) \/\/ or play","  case RTMPConnection.Code.connectFailed.rawValue, RTMPConnection.Code.connectClosed.rawValue:","    connection?.connect(uri)","  default:","    break","  }","}"],"type":"codeListing"},{"type":"heading","text":"2.0.0","level":5,"anchor":"200"},{"syntax":"swift","code":["connection = RTMPConnection()","stream = RTMPStream(connection: connection)","","do {","  let response = try await connection.connect(preference.uri ?? \"\")","  try await stream.publish(Preference.default.streamName) \/\/ or play","} catch RTMPConnection.Error.requestFailed(let response) {","  logger.warn(response)","} catch RTMPStream.Error.requestFailed(let response) {","  logger.warn(response)","} catch {","  logger.warn(error)","}"],"type":"codeListing"},{"type":"heading","text":"RTMPConnectionDelegate","level":4,"anchor":"RTMPConnectionDelegate"},{"type":"heading","text":"1.9.x","level":5,"anchor":"19x"},{"syntax":"swift","code":["\/\/\/ The interface a RTMPConnectionDelegate uses to inform its delegate.","public protocol RTMPConnectionDelegate: AnyObject {","  \/\/\/ Tells the receiver to publish insufficient bandwidth occured.","  func connection(_ connection: RTMPConnection, publishInsufficientBWOccured stream: RTMPStream)","  \/\/\/ Tells the receiver to publish sufficient bandwidth occured.","  func connection(_ connection: RTMPConnection, publishSufficientBWOccured stream: RTMPStream)","  \/\/\/ Tells the receiver to update statistics.","  func connection(_ connection: RTMPConnection, updateStats stream: RTMPStream)","}","","var connection: RTMPConnect","connection.delegate = self"],"type":"codeListing"},{"type":"heading","text":"2.0.0","level":5,"anchor":"200"},{"syntax":"swift","code":["\/\/\/ The struct represents a network statistics.","public struct NetworkMonitorReport: Sendable {","    \/\/\/ The statistics of total incoming bytes.","    public let totalBytesIn: Int","    \/\/\/ The statistics of total outgoing bytes.","    public let totalBytesOut: Int","    \/\/\/ The statistics of outgoing queue bytes per second.","    public let currentQueueBytesOut: Int","    \/\/\/ The statistics of incoming bytes per second.","    public let currentBytesInPerSecond: Int","    \/\/\/ The statistics of outgoing bytes per second.","    public let currentBytesOutPerSecond: Int","}","","\/\/\/ A type with a network bitrate strategy representation.","public protocol HKStreamBitRateStrategy: Sendable {","  \/\/\/ The mamimum video bitRate.","  var mamimumVideoBitRate: Int { get }","  \/\/\/ The mamimum audio bitRate.","  var mamimumAudioBitRate: Int { get }","","  \/\/\/ Adjust a bitRate.","  func adjustBitrate(_ event: NetworkMonitorEvent, stream: some HKStream) async","}","","\/\/\/ An enumeration that indicate the network monitor event.","public enum NetworkMonitorEvent: Sendable {","  \/\/\/ To update statistics.","  case status(report: NetworkMonitorReport)","  \/\/\/ To publish sufficient bandwidth occured.","  case publishInsufficientBWOccured(report: NetworkMonitorReport)","  \/\/\/ To reset statistics.","  case reset","}","","final final actor MyStreamBitRateStrategy: HKStreamBitRateStrategy {","  func adjustBitrate(_ event: NetworkMonitorEvent, stream: some HKStream) async {","  }","}","","var stream: (any HKStream)","var strategy = MyStreamBitRateStrategy()","async stream.setBitrateStrategy(strategy)"],"type":"codeListing"},{"level":3,"type":"heading","text":"SRT","anchor":"SRT"},{"level":4,"type":"heading","text":"Signature","anchor":"Signature"},{"type":"table","header":"row","alignments":["left","left"],"rows":[[[{"inlineContent":[{"text":"1.9.x","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"2.0.0","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"public class SRTConnection"}],"type":"paragraph"}],[{"inlineContent":[{"text":"actor SRTConnection","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"final class SRTStream","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"actor SRTStream","type":"text"}],"type":"paragraph"}]]]},{"level":3,"type":"heading","text":"Others","anchor":"Others"},{"level":4,"type":"heading","text":"Discontinued","anchor":"Discontinued"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Support "},{"type":"reference","identifier":"https:\/\/github.com\/Carthage\/Carthage","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]}]},{"level":4,"type":"heading","text":"ASClass","anchor":"ASClass"},{"type":"table","header":"row","alignments":["left","left"],"rows":[[[{"inlineContent":[{"text":"1.9.x","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"2.0.0","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"ASObject","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"AMFObject","type":"text"}],"type":"paragrap