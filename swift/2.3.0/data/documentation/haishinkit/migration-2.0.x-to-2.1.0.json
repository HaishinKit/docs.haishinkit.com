{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/HaishinKit\/documentation\/HaishinKit\/migration-2.0.x-to-2.1.0"},"metadata":{"modules":[{"name":"HaishinKit"}],"roleHeading":"Article","role":"article","title":"Moving from 2.0.x APIs to 2.1.0"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is a historical migration guide. Code examples refer to the versions shown in each section and may not match the current release."}]},{"level":3,"type":"heading","anchor":"Package","text":"Package"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In this version, we have restructured the module configuration. The RTMP-related features that were previously in HaishinKit have been moved to RTMPHaishinKit."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Several classes that were previously at the public level have been changed to package-level and are no longer exposed."}]},{"anchor":"Import","type":"heading","level":4,"text":"Import"},{"anchor":"20x","text":"2.0.x","type":"heading","level":5},{"type":"codeListing","syntax":"swift","code":["import HaishinKit","","let connection = RTMPConnection()"]},{"anchor":"21x","type":"heading","level":5,"text":"2.1.x"},{"code":["import HaishinKit","import RTMPHaishinKit","","let connection = RTMPConnection()"],"type":"codeListing","syntax":"swift"},{"anchor":"Package-Manager","type":"heading","level":4,"text":"Package Manager"},{"inlineContent":[{"isActive":true,"identifier":"https:\/\/github.com\/HaishinKit\/HaishinKit.swift\/discussions\/1672","type":"reference"},{"type":"text","text":", support for CocoaPods has been discontinued."}],"type":"paragraph"},{"anchor":"20x","type":"heading","level":5,"text":"2.0.x"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"CocoaPods"}],"type":"paragraph"}],"checked":true},{"content":[{"type":"paragraph","inlineContent":[{"text":"SwiftPM","type":"text"}]}],"checked":true}]},{"text":"2.1.0","anchor":"210","type":"heading","level":5},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"SwiftPM"}]}],"checked":true}]},{"anchor":"MediaMixer","text":"MediaMixer","type":"heading","level":3},{"anchor":"Change-in-behavior","text":"Change in behavior","type":"heading","level":4},{"inlineContent":[{"type":"text","text":"Since around iOS 18, when attaching a device during capture with AVCaptureMultiCamSession, the application’s UI becomes locked for several seconds. To address this, we have changed the behavior to start capture manually."}],"type":"paragraph"},{"anchor":"20x","text":"2.0.x","type":"heading","level":5},{"syntax":"swift","code":["import HaishinKit","","let mixer = MediaMixer()","\/\/ Capture was automatically started under certain conditions.","await mixer.attachVideo(AVCaptureDevice.default(.builtInWideAngleCamera, for: .video, position: .back))","await mixer.addOutput(view)"],"type":"codeListing"},{"anchor":"210","text":"2.1.0","type":"heading","level":5},{"syntax":"swift","code":["import HaishinKit","","let mixer = MediaMixer()","await mixer.attachVideo(AVCaptureDevice.default(.builtInWideAngleCamera, for: .video, position: .back))","await mixer.addOutput(view)","","\/\/ Calling startRunning() is now required.","await mixer.startRunning()"],"type":"codeListing"},{"anchor":"frameRate","text":"frameRate","type":"heading","level":4},{"inlineContent":[{"type":"text","text":"Frame rate specification has been changed to allow separate settings for output configuration and camera input."}],"type":"paragraph"},{"anchor":"20x","text":"2.0.x","type":"heading","level":5},{"syntax":"swift","code":["await mixer.setFrameRate(fps)"],"type":"codeListing"},{"anchor":"210","text":"2.1.0","type":"heading","level":5},{"code":["\/\/ Sets to video camera capture frameRate.","try? await mixer.configuration(video: 0) { video in","  do {","    try video.setFrameRate(fps)","  } catch {","    logger.error(error)","  }","}","","\/\/ Sets to output frameRate.","try await mixer.setFrameRate(fps)"],"type":"codeListing","syntax":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/HaishinKit\/documentation\/HaishinKit","doc:\/\/HaishinKit\/documentation\/HaishinKit\/migration-guide"]]},"variants":[{"paths":["\/documentation\/haishinkit\/migration-2.0.x-to-2.1.0"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"kind":"article","abstract":[{"type":"text","text":"Update code written for HaishinKit 2.0.x to use the 2.1.0 APIs."}],"schemaVersion":{"major":0,"patch":0,"minor":3},"seeAlsoSections":[{"identifiers":["doc:\/\/HaishinKit\/documentation\/HaishinKit\/migration-2.2.x-to-2.3.x","doc:\/\/HaishinKit\/documentation\/HaishinKit\/migration-1.9.x-to-2.0.0"],"title":"Migrating to 2.x","generated":true,"anchor":"Migrating-to-2x"}],"references":{"doc://HaishinKit/documentation/HaishinKit/migration-1.9.x-to-2.0.0":{"identifier":"doc:\/\/HaishinKit\/documentation\/HaishinKit\/migration-1.9.x-to-2.0.0","abstract":[{"type":"text","text":"Update code written for HaishinKit 1.9.x to use the 2.0.0 APIs."}],"type":"topic","url":"\/documentation\/haishinkit\/migration-1.9.x-to-2.0.0","role":"article","title":"Moving from 1.9.x APIs to 2.0.0","kind":"article"},"doc://HaishinKit/documentation/HaishinKit/migration-guide":{"abstract":[{"type":"text","text":"Find the API changes and code examples for upgrading between HaishinKit versions."}],"identifier":"doc:\/\/HaishinKit\/documentation\/HaishinKit\/migration-guide","url":"\/documentation\/haishinkit\/migration-guide","kind":"article","title":"Migration Guide","role":"collectionGroup","type":"topic"},"https://github.com/HaishinKit/HaishinKit.swift/discussions/1672":{"url":"https:\/\/github.com\/HaishinKit\/HaishinKit.swift\/discussions\/1672","type":"link","identifier":"https:\/\/github.com\/HaishinKit\/HaishinKit.swift\/discussions\/1672","titleInlineContent"