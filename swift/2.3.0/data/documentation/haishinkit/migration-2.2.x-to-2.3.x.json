{"hierarchy":{"paths":[["doc:\/\/HaishinKit\/documentation\/HaishinKit","doc:\/\/HaishinKit\/documentation\/HaishinKit\/migration-guide"]]},"kind":"article","metadata":{"modules":[{"name":"HaishinKit"}],"roleHeading":"Article","title":"Moving from 2.2.x APIs to 2.3.x","role":"article"},"sections":[],"seeAlsoSections":[{"generated":true,"anchor":"Migrating-to-2x","identifiers":["doc:\/\/HaishinKit\/documentation\/HaishinKit\/migration-2.0.x-to-2.1.0","doc:\/\/HaishinKit\/documentation\/HaishinKit\/migration-1.9.x-to-2.0.0"],"title":"Migrating to 2.x"}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"inlineContent":[{"text":"This guide is based on the changes between the ","type":"text"},{"type":"codeVoice","code":"2.2.5"},{"text":" tag and ","type":"text"},{"type":"codeVoice","code":"main"},{"text":" at commit ","type":"text"},{"type":"codeVoice","code":"18180831"},{"text":". At the time of writing, 2.3.x has not been released. The changes below describe the current implementation and should be reviewed against the final release before upgrading a production application.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The main source changes affect applications that use the Session API or offscreen video mixing. Applications using ","type":"text"},{"type":"codeVoice","code":"RTMPConnection"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"RTMPStream"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"SRTConnection"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"SRTStream"},{"text":" directly can continue using those APIs.","type":"text"}],"type":"paragraph"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Area"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Required action"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Session API"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Rename the shared "},{"type":"codeVoice","code":"Session"},{"type":"text","text":" types to "},{"type":"codeVoice","code":"StreamSession"},{"type":"text","text":" types."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Camera overlays"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Replace "},{"type":"codeVoice","code":"VideoTrackScreenObject"},{"type":"text","text":" with "},{"type":"codeVoice","code":"VideoScreenObject"},{"type":"text","text":"."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Image overlays"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Replace "},{"type":"codeVoice","code":"ImageScreenObject.cgImage"},{"type":"text","text":" with "},{"type":"codeVoice","code":"ciImage"},{"type":"text","text":"."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Renderer selection"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Remove assignments to "},{"type":"codeVoice","code":"Screen.isGPURendererEnabled"},{"type":"text","text":"."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Custom screen objects"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Return "},{"type":"codeVoice","code":"CIImage"},{"type":"text","text":" from "},{"type":"codeVoice","code":"makeImage(_:)"},{"type":"text","text":" and update overridden initializers."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Raw offscreen output"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Handle bi-planar YCbCr buffers instead of assuming packed ARGB."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Session URLs"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Supply an absolute URL with a scheme and host, except for SRT listener URLs."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"visionOS applications"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Raise the minimum deployment target to visionOS 1.3."}]}]]],"type":"table"},{"level":3,"text":"Rename the Session API","type":"heading","anchor":"Rename-the-Session-API"},{"inlineContent":[{"text":"The shared session types have been renamed. There are no compatibility aliases for the old names.","type":"text"}],"type":"paragraph"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"2.2.x"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"2.3.x"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Session"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"StreamSession"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SessionMode"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"StreamSessionMode"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SessionReadyState"}]}],[{"type":"paragraph","inlineContent":[{"code":"StreamSessionReadyState","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SessionBuilder"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"StreamSessionBuilder"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SessionBuilderFactory"}]}],[{"type":"paragraph","inlineContent":[{"code":"StreamSessionBuilderFactory","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"SessionFactory","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"StreamSessionFactory"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"SessionConfiguration","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"StreamSessionConfiguration","type":"codeVoice"}]}]]],"type":"table"},{"type":"paragraph","inlineContent":[{"text":"Update stored properties, function signatures, protocol conformances, and references to ","type":"text"},{"code":"SessionBuilderFactory.Error","type":"codeVoice"},{"text":" as well as calls to the builder.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The concrete factories keep their names: ","type":"text"},{"code":"RTMPSessionFactory","type":"codeVoice"},{"text":", ","type":"text"},{"code":"SRTSessionFactory","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"HTTPSessionFactory","type":"codeVoice"},{"text":". ","type":"text"},{"code":"HTTPSessionConfiguration","type":"codeVoice"},{"text":" also keeps its name, but now conforms to ","type":"text"},{"code":"StreamSessionConfiguration","type":"codeVoice"},{"text":".","type":"text"}]},{"text":"2.2.x","level":4,"type":"heading","anchor":"22x"},{"type":"codeListing","code":["import Foundation","import HaishinKit","import RTMPHaishinKit","","func makePublishingSession() async throws -> (any Session)? {","    await SessionBuilderFactory.shared.register(RTMPSessionFactory())","    return try await SessionBuilderFactory.shared","        .make(URL(string: \"rtmp:\/\/localhost\/live\/stream\"))","        .setMode(.publish)","        .build()","}"],"syntax":"swift"},{"type":"heading","text":"2.3.x","level":4,"anchor":"23x"},{"type":"codeListing","code":["import Foundation","import HaishinKit","import RTMPHaishinKit","","func makePublishingSession() async throws -> (any StreamSession)? {","    await StreamSessionBuilderFactory.shared.register(RTMPSessionFactory())","    return try await StreamSessionBuilderFactory.shared","        .make(URL(string: \"rtmp:\/\/localhost\/live\/stream\"))","        .setMode(.publish)","        .build()","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"build()"},{"text":" still returns an optional session and can throw. Keep the existing optional handling and error handling. The ","type":"text"},{"type":"codeVoice","code":".publish"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":".playback"},{"text":" modes, factory registration, and connection workflow are unchanged.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"If you provide a custom session factory, update its ","type":"text"},{"type":"codeVoice","code":"make(_:mode:configuration:)"},{"text":" signature to accept ","type":"text"},{"type":"codeVoice","code":"StreamSessionMode"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"(any StreamSessionConfiguration)?"},{"text":", and return ","type":"text"},{"type":"codeVoice","code":"any StreamSession"},{"text":". Custom sessions must expose ","type":"text"},{"type":"codeVoice","code":"AsyncStream<StreamSessionReadyState>"},{"text":" and use the renamed types in their initializer.","type":"text"}]},{"type":"heading","text":"Rename VideoTrackScreenObject","level":3,"anchor":"Rename-VideoTrackScreenObject"},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"type":"codeVoice","code":"VideoScreenObject"},{"text":" for a camera-track overlay. Its ","type":"text"},{"type":"codeVoice","code":"track"},{"text":", size, alignment, layout margins, corner radius, and video-effect APIs retain their roles. The track number must still match the track passed to ","type":"text"},{"type":"codeVoice","code":"MediaMixer.attachVideo(_:track:)"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Both examples run on ","type":"text"},{"type":"codeVoice","code":"ScreenActor"},{"text":", as required by the screen APIs.","type":"text"}]},{"type":"heading","text":"2.2.x","level":4,"anchor":"22x"},{"type":"codeListing","code":["import HaishinKit","","@ScreenActor","func makeCameraOverlay() -> VideoTrackScreenObject {","    let overlay = VideoTrackScreenObject()","    overlay.track = 1","    overlay.size = .init(width: 320, height: 180)","    overlay.horizontalAlignment = .right","    overlay.layoutMargin = .init(top: 16, left: 0, bottom: 0, right: 16)","    return overlay","}"],"syntax":"swift"},{"type":"heading","text":"2.3.x","level":4,"anchor":"23x"},{"type":"codeListing","code":["import HaishinKit","","@ScreenActor","func makeCameraOverlay() -> VideoScreenObject {","    let overlay = VideoScreenObject()","    overlay.track = 1","    overlay.size = .init(width: 320, height: 180)","    overlay.horizontalAlignment = .right","    overlay.layoutMargin = .init(top: 16, left: 0, bottom: 0, right: 16)","    return overlay","}"],"syntax":"swift"},{"type":"heading","text":"Replace CGImage overlays with CIImage overlays","level":3,"anchor":"Replace-CGImage-overlays-with-CIImage-overlays"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ImageScreenObject.cgImage"},{"text":" has been replaced with ","type":"text"},{"type":"codeVoice","code":"ciImage"},{"text":". Convert an existing ","type":"text"},{"type":"codeVoice","code":"CGImage"},{"text":" with ","type":"text"},{"type":"codeVoice","code":"CIImage(cgImage:)"},{"text":", or supply a ","type":"text"},{"type":"codeVoice","code":"CIImage"},{"text":" directly.","type":"text"}]},{"type":"heading","text":"2.2.x","level":4,"anchor":"22x"},{"type":"codeListing","code":["import CoreGraphics","import HaishinKit","","@ScreenActor","func makeImageOverlay(_ image: CGImage) -> ImageScreenObject {","    let overlay = ImageScreenObject()","    overlay.cgImage = image","    overlay.size = .init(width: image.width, height: image.height)","    return overlay","}"],"syntax":"swift"},{"type":"heading","text":"2.3.x","level":4,"anchor":"23x"},{"type":"codeListing","code":["import CoreImage","import HaishinKit","","@ScreenActor","func makeImageOverlay(_ image: CGImage) -> ImageScreenObject {","    let overlay = ImageScreenObject()","    overlay.ciImage = CIImage(cgImage: image)","    overlay.size = .init(width: image.width, height: image.height)","    return overlay","}"],"syntax":"swift"},{"type":"heading","text":"Remove the renderer switch","level":3,"anchor":"Remove-the-renderer-switch"},{"type":"paragraph","inlineContent":[{"text":"Offscreen rendering now uses the Core Image renderer (","type":"text"},{"type":"codeVoice","code":"ScreenRendererByGPU"},{"text":"). The separate CPU renderer and ","type":"text"},{"type":"codeVoice","code":"Screen.isGPURendererEnabled"},{"text":" have been removed. No replacement flag is required; remove both ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"false"},{"text":" assignments to this property.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For example, remove this configuration used in 2.2.1 and later:","type":"text"}]},{"type":"codeListing","code":["@ScreenActor","func configureRenderer(_ screen: Screen) {","    screen.isGPURendererEnabled = true","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Keep your existing offscreen mixing configuration, including ","type":"text"},{"type":"codeVoice","code":"VideoMixerSettings.mode = .offscreen"},{"text":" when compositing overlays. Removing the renderer flag does not enable offscreen mixing by itself.","type":"text"}]},{"type":"heading","text":"Update custom ScreenObject subclasses","level":3,"anchor":"Update-custom-ScreenObject-subclasses"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"makeImage(_:) -> CGImage?"},{"text":" overload has been removed. Override the ","type":"text"},{"type":"codeVoice","code":"CIImage?"},{"text":" overload instead. If your drawing code still produces a ","type":"text"},{"type":"codeVoice","code":"CGImage"},{"text":", wrap the result in ","type":"text"},{"type":"codeVoice","code":"CIImage(cgImage:)"},{"text":" before returning it.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The base initializer is now ","type":"text"},{"type":"codeVoice","code":"init(id: String? = nil)"},{"text":". Calls such as ","type":"text"},{"type":"codeVoice","code":"ScreenObject()"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"super.init()"},{"text":" still work because the argument has a default. However, a subclass that overrides ","type":"text"},{"type":"codeVoice","code":"init()"},{"text":" must update that override to the new signature, or remove ","type":"text"},{"type":"codeVoice","code":"override"},{"text":" if it intentionally defines a separate zero-argument initializer.","type":"text"}]},{"type":"heading","text":"2.2.x","level":4,"anchor":"22x"},{"type":"codeListing","code":["import CoreGraphics","import HaishinKit","","@ScreenActor","final class LogoScreenObject: ScreenObject {","    var image: CGImage? {","        didSet { invalidateLayout() }","    }","","    override init() {","        super.init()","        size = .init(width: 128, height: 128)","    }","","    override func makeImage(_ renderer: some ScreenRenderer) -> CGImage? {","        return image","    }","}"],"syntax":"swift"},{"type":"heading","text":"2.3.x","level":4,"anchor":"23x"},{"type":"codeListing","code":["import CoreImage","import HaishinKit","","@ScreenActor","final class LogoScreenObject: ScreenObject {","    var image: CGImage? {","        didSet { invalidateLayout() }","    }","","    override init(id: String? = nil) {","        super.init(id: id)","        size = .init(width: 128, height: 128)","    }","","    override func makeImage(_ renderer: some ScreenRenderer) -> CIImage? {","        return image.map { CIImage(cgImage: $0) }","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Screen objects now have an immutable ","type":"text"},{"type":"codeVoice","code":"id"},{"text":". If omitted, a UUID string is generated. You can supply a stable identifier and find the object later with ","type":"text"},{"type":"codeVoice","code":"Screen.findById(_:)"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"ScreenObjectContainer.findById(_:)"},{"text":". Keep identifiers unique within a screen. Existing applications do not need to adopt explicit identifiers to keep using overlays.","type":"text"}]},{"type":"heading","text":"Check the offscreen output pixel format","level":3,"anchor":"Check-the-offscreen-output-pixel-format"},{"type":"paragraph","inlineContent":[{"text":"For SDR, the pixel buffers allocated by ","type":"text"},{"type":"codeVoice","code":"Screen"},{"text":" change from ","type":"text"},{"type":"codeVoice","code":"kCVPixelFormatType_32ARGB"},{"text":" to ","type":"text"},{"type":"codeVoice","code":"kCVPixelFormatType_420YpCbCr8BiPlanarVideoRange"},{"text":". HDR uses ","type":"text"},{"type":"codeVoice","code":"kCVPixelFormatType_420YpCbCr10BiPlanarVideoRange"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"If a custom mixer output, recorder, or image-processing step reads the offscreen pixel buffer directly, check ","type":"text"},{"type":"codeVoice","code":"CVPixelBufferGetPixelFormatType(_:)"},{"text":". Do not assume a single plane or four bytes per pixel. Use the appropriate plane accessors for YCbCr data, or convert to the format your consumer requires. This change concerns buffers produced by offscreen rendering, not a guarantee about every captured or passthrough buffer.","type":"text"}]},{"type":"heading","text":"Validate streaming URLs","level":3,"anchor":"Validate-streaming-URLs"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"StreamSessionBuilderFactory.make(_:)"},{"text":" now throws ","type":"text"},{"type":"codeVoice","code":"StreamSessionBuilderFactory.Error.illegalArgument"},{"text":" for URLs without a scheme or host, and for an empty host on non-SRT URLs. Use an absolute URL such as ","type":"text"},{"type":"codeVoice","code":"rtmp:\/\/localhost\/live\/stream"},{"text":", rather than a relative path or a host-only string. A valid URL with no registered protocol factory still fails with ","type":"text"},{"type":"codeVoice","code":".notFound"},{"text":" when building the session.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"SRT listener URLs with an empty host, such as ","type":"text"},{"type":"codeVoice","code":"srt:\/\/:9710?mode=listener"},{"text":", remain supported. SRT caller URLs should specify the remote host. RTMP connection validation also rejects an empty host, and HTTP sessions reject invalid HTTP\/HTTPS endpoints before creating a peer connection.","type":"text"}]},{"type":"heading","text":"Update package and platform requirements","level":3,"anchor":"Update-package-and-platform-requirements"},{"type":"paragraph","inlineContent":[{"text":"The minimum visionOS deployment version increases from 1.0 to 1.3. The other declared minimums remain iOS 15, tvOS 15, Mac Catalyst 15, and macOS 12. The package still declares Swift tools version 6.0.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"SRT and WebRTC now obtain their binary frameworks through the ","type":"text"},{"type":"codeVoice","code":"libsrt-xcframework"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"libdatachannel-xcframework"},{"text":" Swift packages, with minimum dependency versions 1.5.7 and 0.24.6 respectively. Previously, the root package declared direct binary targets for libsrt 1.5.4 and libdatachannel 0.24.0. Resolve package dependencies again after updating, and review any application-level pins to the older dependencies. The ","type":"text"},{"type":"codeVoice","code":"SRTHaishinKit"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"RTCHaishinKit"},{"text":" product and import names are unchanged.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"SRT address resolution now supports IPv6 as well as IPv4. Existing IPv4 callers do not need a new API. If you use an IPv6 listener, configure the local ","type":"text"},{"type":"codeVoice","code":"adapter"},{"text":" explicitly; the default local adapter is still ","type":"text"},{"type":"codeVoice","code":"0.0.0.0"},{"text":". For example, ","type":"text"},{"type":"codeVoice","code":"srt:\/\/:9710?mode=listener&adapter=::"},{"text":" selects an IPv6 wildcard address.","type":"text"}]},{"type":"heading","text":"Verify the migration","level":3,"anchor":"Verify-the-migration"},{"type":"paragraph","inlineContent":[{"text":"After applying the changes:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Build each application target to find references to the removed names and overridden initializers.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Exercise session creation, publish\/playback, and reconnection with your actual endpoint URLs.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Check image overlays, camera overlays, custom drawing, and any consumers of raw offscreen pixel buffers.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Test SRT caller\/listener behavior for the address families and adapters used by your application.","type":"text"}]}]}]},{"type":"heading","text":"Reference","level":3,"anchor":"Reference"},{"type":"paragraph","inlineContent":[{"text":"The API changes in this draft were checked against the ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/HaishinKit\/HaishinKit.swift\/compare\/2.2.5...181808311f5e89572a4de5c67de4ce34cede89cf"},{"text":". Changes made after that commit are not covered by this draft.","type":"text"}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/haishinkit\/migration-2.2.x-to-2.3.x"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/HaishinKit\/documentation\/HaishinKit\/migration-2.2.x-to-2.3.x"},"abstract":[{"text":"Update session types and screen rendering code for the upcoming 2.3.x release.","type":"text"}],"references":{"doc://HaishinKit/documentation/HaishinKit/migration-2.0.x-to-2.1.0":{"url":"\/documentation\/haishinkit\/migration-2.0.x-to-2.1.0","title":"Moving from 2.0.x APIs to 2.1.0","role":"article","kind":"article","type":"topic","identifier":"doc:\/\/HaishinKit\/documentation\/HaishinKit\/migration-2.0.x-to-2.1.0","abstract":[{"type":"text","text":"Update code written for HaishinKit 2.0.x to use the 2.1.0 APIs."}]},"https://github.com/HaishinKit/HaishinKit.swift/compare/2.2.5...181808311f5e89572a4de5c67de4ce34cede89cf":{"url":"https:\/\/github.com\/HaishinKit\/HaishinKit.swift\/compare\/2.2.5...181808311f5e89572a4de5c67de4ce34cede89cf","title":"source comparison from 2.2.5 to 18180831","identifier":"https:\/\/github.com\/HaishinKit\/HaishinKit.swift\/compare\/2.2.5...181808311f5e89572a4de5c67de4ce34cede89cf","titleInlineContent":[{"type":"text","text":"source comparison from 2.2.5 to 18180831"}],"type":"link"},"doc://HaishinKit/documentation/HaishinKit/migration-1.9.x-to-2.0.0":{"identifier":"doc:\/\/HaishinKit\/documentation\/HaishinKit\/migration-1.9.x-to-2.0.0","abstract":[{"type":"text","text":"Update code written for HaishinKit 1.9.x to use the 2.0.0 APIs."}],"type":"topic","url":"\/documentation\/haishinkit\/migration-1.9.x-to-2.0.0","role":"article","title":"Moving from 1.9.x APIs to 2.0.0","kind":"article"},"doc://HaishinKit/documentation/HaishinKit":{"abstract":[{"text":"This is the main module.","type":"text"}],"identifier":"doc:\/\/HaishinKit\/documentation\/HaishinKit","url":"\/documentation\/haishinkit","kind":"symbol","title":"HaishinKit","role":"collection","type":"topic"},"doc://HaishinKit/documentation/HaishinKit/migration-guide":{"abstract":[{"type":"text","text":"Find the API changes and code examples for upgrading between HaishinKit versions."}],"identifier":"doc:\/\/HaishinKit\/documentation\/HaishinKit\/migration-guide","url":"\/documentation\/haishinkit\/migration-guide","kind":"article","title":"Migration Guide","role":"collectionGroup","type":"topic"}}}